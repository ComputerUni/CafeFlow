@model List<CafeFlow.DTO.Comment.CommentListDto>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var totalCount = Model?.Count ?? 0;
    var approvedCount = Model?.Count(x => x.IsApproved) ?? 0;
    var hiddenCount = totalCount - approvedCount;
    var avgRating = totalCount > 0 ? Model!.Average(x => x.Rating) : 0;
}

<div class="adm-content mw-100">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">Yorum Yönetimi</h1>
            <p class="adm-page-sub">Müşteri yorumlarını inceleyin ve vitrinde yayınlanıp yayınlanmayacağına karar verin.</p>
        </div>
    </div>

    <div class="adm-stats">
        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-rose"><i class="bi bi-chat-left-quote"></i></div>
            <div>
                <div class="adm-stat-value">@totalCount</div>
                <div class="adm-stat-label">Toplam Yorum</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-green"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="adm-stat-value">@approvedCount</div>
                <div class="adm-stat-label">Yayındaki Yorum</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-muted"><i class="bi bi-eye-slash"></i></div>
            <div>
                <div class="adm-stat-value">@hiddenCount</div>
                <div class="adm-stat-label">Gizli / Onaysız</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-peach"><i class="bi bi-star-fill"></i></div>
            <div>
                <div class="adm-stat-value">@avgRating.ToString("0.0")</div>
                <div class="adm-stat-label">Ortalama Puan</div>
            </div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-toolbar">
            <div class="adm-input-icon">
                <i class="bi bi-search"></i>
                <input type="text" id="commentSearch" class="adm-input" placeholder="Müşteri, ürün veya yorum ara..." onkeyup="filterComments()" />
            </div>

            <div class="adm-segment">
                <button type="button" class="active" onclick="filterByStatus('all', this)">Tümü</button>
                <button type="button" onclick="filterByStatus('approved', this)">Yayında</button>
                <button type="button" onclick="filterByStatus('hidden', this)">Gizli</button>
            </div>

            <div class="adm-counter">
                Toplam <strong id="commentCount">@totalCount</strong> yorum
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="adm-table-wrap">
                <table class="adm-table" id="commentsTable">
                    <thead>
                        <tr>
                            <th>Müşteri</th>
                            <th>Ürün</th>
                            <th>Yorum</th>
                            <th>Puan</th>
                            <th>Yayın Durumu</th>
                            <th>Tarih</th>
                            <th class="end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.CreatedDate))
                        {
                            var customerName = string.IsNullOrWhiteSpace(item.CustomerName) ? "Misafir" : item.CustomerName;
                            var status = item.IsApproved ? "approved" : "hidden";

                            <tr data-status="@status" data-search="@customerName.ToLower() @item.ProductName?.ToLower() @item.Content?.ToLower()">
                                <td class="cell-main">
                                    <div class="adm-entity">
                                        <div class="adm-thumb">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div>
                                            <strong>@customerName</strong>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Ürün">
                                    @if (!string.IsNullOrWhiteSpace(item.ProductName))
                                    {
                                        <span class="adm-badge adm-badge-info no-dot">@item.ProductName</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge adm-badge-neutral no-dot">Genel Kafe</span>
                                    }
                                </td>

                                <td class="cell-desc" data-label="Yorum">
                                    <div class="adm-desc" title="@item.Content">@item.Content</div>
                                </td>

                                <td data-label="Puan">
                                    <span class="adm-badge adm-badge-warning no-dot">
                                        <i class="bi bi-star-fill"></i>
                                        <span>@item.Rating / 5</span>
                                    </span>
                                </td>

                                <td data-label="Yayın Durumu">
                                    <form asp-area="Admin" asp-controller="Comment" asp-action="ChangeStatus" asp-route-id="@item.Id" method="post" class="adm-status-cell">
                                        <label class="adm-switch">
                                            <input type="checkbox" @(item.IsApproved ? "checked" : null) onchange="this.form.submit()" />
                                            <span class="adm-switch-track"></span>
                                        </label>

                                        @if (item.IsApproved)
                                        {
                                            <span class="adm-badge adm-badge-success">Yayında</span>
                                        }
                                        else
                                        {
                                            <span class="adm-badge adm-badge-inactive">Gizli</span>
                                        }
                                    </form>
                                </td>

                                <td data-label="Tarih">
                                    <span class="adm-date">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                                </td>

                                <td class="end cell-actions">
                                    <a asp-area="Admin"
                                       asp-controller="Comment"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');"
                                       class="adm-icon-btn bordered text-danger"
                                       title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="adm-empty">
                <div class="adm-empty-art"><i class="bi bi-chat-left-quote"></i></div>
                <h3>Henüz müşteri yorumu bulunmuyor</h3>
                <p>Müşteriler değerlendirme gönderdiğinde burada listelenecektir.</p>
            </div>
        }
    </div>
</div>

<script>
    let currentStatus = 'all';

    function filterByStatus(status, btn) {
        currentStatus = status;
        document.querySelectorAll('.adm-segment button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterComments();
    }

    function filterComments() {
        const text = document.getElementById('commentSearch').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#commentsTable tbody tr');
        let count = 0;

        rows.forEach(row => {
            const matchStatus = currentStatus === 'all' || row.dataset.status === currentStatus;
            const matchText = (row.dataset.search || '').includes(text);
            const show = matchStatus && matchText;

            row.classList.toggle('d-none', !show);
            if (show) count++;
        });

        document.getElementById('commentCount').textContent = count;
    }
</script>