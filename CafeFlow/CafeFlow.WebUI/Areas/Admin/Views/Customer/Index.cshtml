@model List<CafeFlow.DTO.Customer.CustomerListDto>

@{
    ViewData["Title"] = "Müşteriler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var customers = Model ?? new List<CafeFlow.DTO.Customer.CustomerListDto>();
}

<div class="adm-content mw-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 mb-1 fw-bold">Müşteriler</h1>
            <p class="text-muted small mb-0">Sipariş oluşturan kayıtlı ve misafir müşteri bilgilerini görüntüleyin.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 260px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" id="customerSearch" class="form-control border-start-0 ps-0" placeholder="İsim, e-posta, telefon ara..." />
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                Toplam: <strong id="customerCount">@customers.Count</strong>
            </span>
        </div>
    </div>

    <div class="adm-card">
        <div class="table-responsive">
            <table class="table adm-table align-middle mb-0" id="customersTable">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Müşteri</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Adres</th>
                    </tr>
                </thead>
                <tbody>
                    @if (customers.Any())
                    {
                        foreach (var item in customers)
                        {
                            var initials = !string.IsNullOrWhiteSpace(item.FullName)
                                ? string.Concat(item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])))
                                : "M";

                            <tr class="customer-row">
                                <td class="text-muted fw-semibold">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold flex-shrink-0"
                                             style="width: 34px; height: 34px; background-color: #fdf2f4; color: #b85d6f; font-size: 0.8rem;">
                                            @initials
                                        </div>
                                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(item.FullName) ? "Misafir Müşteri" : item.FullName)</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <span class="text-body">
                                            <i class="bi bi-envelope text-muted me-1"></i>@item.Email
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Belirtilmemiş</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        <span class="text-nowrap">
                                            <i class="bi bi-telephone text-muted me-1"></i>@item.Phone
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Belirtilmemiş</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        <span class="d-inline-block text-truncate" style="max-width: 340px;" title="@item.Address">
                                            <i class="bi bi-geo-alt text-muted me-1"></i>@item.Address
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border fw-normal">Adres Yok</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr id="emptyCustomerRow" class="@(customers.Any() ? "d-none" : "")">
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-3 d-block mb-2"></i>
                            Gösterilecek müşteri kaydı bulunamadı.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("customerSearch");
            const rows = document.querySelectorAll("#customersTable tbody tr.customer-row");
            const emptyRow = document.getElementById("emptyCustomerRow");
            const countEl = document.getElementById("customerCount");

            if (!searchInput) return;

            searchInput.addEventListener("input", () => {
                const term = searchInput.value.trim().toLocaleLowerCase("tr-TR");
                let visible = 0;

                rows.forEach((row) => {
                    const match = row.textContent.toLocaleLowerCase("tr-TR").includes(term);
                    row.classList.toggle("d-none", !match);
                    if (match) visible++;
                });

                if (countEl) countEl.textContent = visible;
                if (emptyRow) emptyRow.classList.toggle("d-none", visible > 0);
            });
        })();
    </script>
}