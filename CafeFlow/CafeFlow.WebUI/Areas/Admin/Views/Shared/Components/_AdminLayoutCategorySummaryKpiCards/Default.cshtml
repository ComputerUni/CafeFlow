<!-- Summary -->
<section class="adm-stats" aria-label="Category summary">
    <div class="adm-stat">
        <span class="adm-stat-icon adm-tone-rose"><i class="bi bi-tags"></i></span>
        <div><div class="adm-stat-value" id="statTotal">0</div><div class="adm-stat-label">Total Categories</div></div>
    </div>
    <div class="adm-stat">
        <span class="adm-stat-icon adm-tone-green"><i class="bi bi-check2-circle"></i></span>
        <div><div class="adm-stat-value" id="statActive">0</div><div class="adm-stat-label">Active Categories</div></div>
    </div>
    <div class="adm-stat">
        <span class="adm-stat-icon adm-tone-muted"><i class="bi bi-pause-circle"></i></span>
        <div><div class="adm-stat-value" id="statInactive">0</div><div class="adm-stat-label">Inactive Categories</div></div>
    </div>
    <div class="adm-stat">
        <span class="adm-stat-icon adm-tone-peach"><i class="bi bi-cup-straw"></i></span>
        <div><div class="adm-stat-value" id="statProducts">0</div><div class="adm-stat-label">Total Products</div></div>
    </div>
</section>