@model List<CafeFlow.DTO.Product.ProductListDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Ürünler";
    var activeCount = Model.Count(x => x.IsActive);
}

<div class="adm-content mw-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 mb-1 fw-bold">Ürünler</h1>
            <p class="text-muted small mb-0">Menü ürünlerini, stok durumlarını, öne çıkan ve özelleştirme ayarlarını yönetin.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Ürün Durum Filtresi">
                <button type="button" class="btn btn-dark text-white filter-btn active" data-filter="all">
                    Tümü (@Model.Count)
                </button>
                <button type="button" class="btn btn-outline-secondary filter-btn" data-filter="active">
                    Aktif (@activeCount)
                </button>
                <button type="button" class="btn btn-outline-secondary filter-btn" data-filter="passive">
                    Pasif (@(Model.Count - activeCount))
                </button>
            </div>
            <div class="input-group input-group-sm" style="width: 230px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" id="productSearch" class="form-control border-start-0 ps-0" placeholder="Ürün veya kategori ara..." />
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-sm btn-dark text-white d-inline-flex align-items-center gap-1 px-3">
                <i class="bi bi-plus-lg"></i>
                <span>Yeni Ürün Ekle</span>
            </a>
        </div>
    </div>

    <div class="adm-card">
        <div class="table-responsive">
            <table class="table adm-table align-middle mb-0" id="productsTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th style="width: 34%;">Ürün</th>
                        <th style="width: 14%;">Kategori</th>
                        <th style="width: 12%;">Fiyat / Stok</th>
                        <th style="width: 80px;">Puan</th>
                        <th class="text-center" style="width: 110px;">Durum</th>
                        <th class="text-center" style="width: 115px;">Öne Çıkan</th>
                        <th class="text-center" style="width: 115px;">Özelleştir</th>
                        <th class="text-end" style="width: 115px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var statusKey = item.IsActive ? "active" : "passive";

                            <tr class="product-row" data-status="@statusKey">
                                <td class="text-muted fw-semibold">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 class="rounded border object-fit-cover flex-shrink-0"
                                                 style="width: 46px; height: 46px;"
                                                 onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="rounded border d-flex align-items-center justify-content-center bg-light text-muted flex-shrink-0"
                                                 style="width: 46px; height: 46px;">
                                                <i class="bi bi-cup-hot"></i>
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="fw-semibold text-dark">@item.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <div class="text-muted small text-truncate" style="max-width: 340px;" title="@item.Description">@item.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill fw-medium px-2 py-1"
                                          style="background-color: #fdf2f4; color: #b85d6f; border: 1px solid #f5d0d8;">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">₺@item.Price.ToString("N2")</div>
                                    <span class="badge @(item.Stock <= 5 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-light text-dark border") fw-normal">
                                        Stok: @item.Stock
                                    </span>
                                </td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1 fw-semibold small text-dark">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        @item.AverageRating.ToString("0.0")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-area="Admin" asp-controller="Product" asp-action="ChangeActive" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                style="min-width: 82px;"
                                                class="btn btn-sm @(item.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") px-2 py-1 fw-medium"
                                                title="Aktiflik Durumunu Değiştir">
                                            <i class="bi @(item.IsActive ? "bi-check-circle-fill" : "bi-slash-circle") me-1"></i>@(item.IsActive ? "Aktif" : "Pasif")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-area="Admin" asp-controller="Product" asp-action="ChangeFeature" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                style="min-width: 82px;"
                                                class="btn btn-sm @(item.IsFeatured ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-light text-dark border") px-2 py-1 fw-medium"
                                                title="Öne Çıkarma Durumunu Değiştir">
                                            <i class="bi @(item.IsFeatured ? "bi-star-fill text-warning" : "bi-star text-muted") me-1"></i>@(item.IsFeatured ? "Evet" : "Hayır")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-area="Admin" asp-controller="Product" asp-action="ChangeCustomizable" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                style="min-width: 84px;"
                                                class="btn btn-sm @(item.IsCustomizable ? "bg-info-subtle text-info-emphasis border border-info-subtle" : "bg-light text-dark border") px-2 py-1 fw-medium"
                                                title="Özelleştirme Seçeneğini Aç/Kapat">
                                            <i class="bi @(item.IsCustomizable ? "bi-sliders" : "bi-lock text-muted") me-1"></i>@(item.IsCustomizable ? "Açık" : "Kapalı")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="Güncelle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form method="post" asp-area="Admin" asp-controller="Product" asp-action="Delete" class="d-inline"
                                              onsubmit="return confirm('@item.Name ürününü silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="emptyProductRow" class="@(Model.Any() ? "d-none" : "")">
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-cup-hot fs-3 d-block mb-2"></i>
                            Gösterilecek ürün bulunamadı.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("productSearch");
            const filterBtns = document.querySelectorAll(".filter-btn");
            const rows = document.querySelectorAll("#productsTable tbody tr.product-row");
            const emptyRow = document.getElementById("emptyProductRow");
            let activeFilter = "all";

            function applyFilters() {
                const term = (searchInput ? searchInput.value : "").trim().toLocaleLowerCase("tr-TR");
                let visible = 0;

                rows.forEach((row) => {
                    const matchesStatus = activeFilter === "all" || row.dataset.status === activeFilter;
                    const matchesSearch = !term || row.textContent.toLocaleLowerCase("tr-TR").includes(term);
                    const show = matchesStatus && matchesSearch;
                    row.classList.toggle("d-none", !show);
                    if (show) visible++;
                });

                if (emptyRow) emptyRow.classList.toggle("d-none", visible > 0);
            }

            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    filterBtns.forEach((b) => {
                        b.classList.remove("active", "btn-dark", "text-white");
                        b.classList.add("btn-outline-secondary");
                    });
                    btn.classList.add("active", "btn-dark", "text-white");
                    btn.classList.remove("btn-outline-secondary");
                    activeFilter = btn.dataset.filter;
                    applyFilters();
                });
            });

            if (searchInput) searchInput.addEventListener("input", applyFilters);
        })();
    </script>
}