@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-main">

    <main class="adm-content" id="main">

        @await Component.InvokeAsync("_AdminLayoutCategoryPageHead")

        @await Component.InvokeAsync("_AdminLayoutCategorySummaryKpiCards")

        <section class="adm-card" aria-label="Categories">
            <div class="adm-toolbar">
                <div class="adm-input-icon">
                    <i class="bi bi-search"></i>
                    <input type="search" class="adm-input" id="searchInput" placeholder="Kategori ara..." aria-label="Search categories" autocomplete="off" />
                    <button type="button" class="adm-input-clear" id="searchClear" aria-label="Clear search"><i class="bi bi-x-lg"></i></button>
                </div>
                <select class="adm-select" id="sortSelect" aria-label="Kategorileri Sırala">
                    <option value="order">Sıralama (Sıra No)</option>
                    <option value="name-asc">İsim: A'dan Z'ye</option>
                    <option value="name-desc">İsim: Z'den A'ya</option>
                    <option value="products">En Çok Ürünü Olan</option>
                    <option value="newest">En Yeni Eklenenler</option>
                </select>
                <div class="adm-segment" role="group" aria-label="View mode">
                    <button type="button" class="active" data-view="table" aria-pressed="true"><i class="bi bi-list-ul"></i> <span class="adm-hide-sm">Table</span></button>
                    <button type="button" data-view="grid" aria-pressed="false"><i class="bi bi-grid"></i> <span class="adm-hide-sm">Grid</span></button>
                </div>
                <span class="adm-counter" id="resultCounter" aria-live="polite"> <strong>0</strong> kategori gösteriliyor</span>
            </div>

            <!-- Table view -->
            <div class="adm-table-wrap" id="tableView">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th scope="col">Kategori</th>
                            <th scope="col">Açıklama</th>
                            <th scope="col" class="num">Ürünler</th>
                            <th scope="col" class="num">Sipariş Sayısı</th>
                            <th scope="col">Oluşturma Tarihi</th>
                            <th scope="col" class="end"><span class="visually-hidden">İşlemler</span></th>
                        </tr>
                    </thead>
                    <tbody id="categoryRows"></tbody>
                </table>
            </div>

            <!-- Grid view -->
            <div class="cat-grid d-none" id="gridView"></div>

            <!-- Empty state -->
            <div class="adm-empty d-none" id="emptyState">
                <div class="adm-empty-art"><i class="bi bi-tags" id="emptyIcon"></i></div>
                <h3 id="emptyTitle">No categories found</h3>
                <p id="emptyText">Try adjusting your search or create your first category.</p>
                <div class="d-flex gap-2 justify-content-center flex-wrap" id="emptyActions"></div>
            </div>

            <!-- Pagination -->
            <div class="adm-pager" id="pager">
                <div class="adm-pager-size">
                    <label for="pageSize">Sayfa başına</label>
                    <select class="adm-select" id="pageSize">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                    </select>
                </div>
                <span id="pageInfo">1–8 of 8</span>
                <nav class="adm-pages" id="pages" aria-label="Pagination"></nav>
            </div>
        </section>

    </main>

</div>

<partial name="Partials/_CategoryModalPartial" />
<partial name="Partials/_CategoryViewModalPartial" />

@section Scripts {
    @await Component.InvokeAsync("_AdminLayoutCategoryScripts")
}
