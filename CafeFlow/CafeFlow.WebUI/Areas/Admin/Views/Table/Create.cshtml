@model CafeFlow.DTO.Table.CreateTableDto

@{
    ViewData["Title"] = "Yeni Masa Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-content mw-100">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">Yeni Masa Ekle</h1>
            <p class="adm-page-sub">Kafe salonuna yeni bir masa ve QR kod tanımlayın.</p>
        </div>
        <a asp-area="Admin" asp-controller="Table" asp-action="Index" class="adm-btn adm-btn-light">
            <i class="bi bi-arrow-left"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="adm-card p-4">
                <form asp-area="Admin" asp-controller="Table" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="TableNumber" class="adm-label">
                            Masa Numarası <span class="req">*</span>
                        </label>
                        <input asp-for="TableNumber" type="number" min="1" class="adm-input" id="tableNumberInput" placeholder="Örn: 6" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="QRCode" class="adm-label">
                            QR Kod Değeri <span class="req">*</span>
                        </label>
                        <div class="d-flex gap-2">
                            <input asp-for="QRCode" type="text" class="adm-input" id="qrCodeInput" placeholder="Örn: TABLE-QR-006" required />
                            <button type="button" class="adm-btn adm-btn-light" onclick="generateQrValue()">
                                <i class="bi bi-magic"></i>
                                <span>Üret</span>
                            </button>
                        </div>
                        <div class="adm-hint">Masa numarasına uygun benzersiz bir QR kodu otomatik oluşturabilirsiniz.</div>
                    </div>

                    <div class="mb-4 pt-1">
                        <label class="adm-switch lg">
                            <input asp-for="IsAvailable" type="checkbox" checked />
                            <span class="adm-switch-track"></span>
                            <span>Masa Müsait (Siparişe Açık)</span>
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-area="Admin" asp-controller="Table" asp-action="Index" class="adm-btn adm-btn-light">İptal</a>
                        <button type="submit" class="adm-btn adm-btn-primary">
                            <i class="bi bi-check-lg"></i>
                            <span>Masayı Kaydet</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function generateQrValue() {
        const num = document.getElementById('tableNumberInput').value || Math.floor(Math.random() * 90 + 10);
        const randomSuffix = Math.random().toString(36).substring(2, 6).toUpperCase();
        document.getElementById('qrCodeInput').value = `CAFEFLOW-MASA-${num}-${randomSuffix}`;
    }
</script>