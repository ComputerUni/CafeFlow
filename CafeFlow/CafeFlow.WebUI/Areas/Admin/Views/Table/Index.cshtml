@model List<CafeFlow.DTO.Table.TableListDto>

@{
    ViewData["Title"] = "Masalar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var totalCount = Model?.Count ?? 0;
    var availableCount = Model?.Count(x => x.IsAvailable) ?? 0;
    var occupiedCount = totalCount - availableCount;
    var occupancyRate = totalCount > 0 ? (int)Math.Round((double)occupiedCount * 100 / totalCount) : 0;
}

<div class="adm-content mw-100">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">Masa Yönetimi</h1>
            <p class="adm-page-sub">Kafe masalarını, QR kodlarını ve anlık doluluk durumlarını yönetin.</p>
        </div>
        <a asp-area="Admin" asp-controller="Table" asp-action="Create" class="adm-btn adm-btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Yeni Masa Ekle</span>
        </a>
    </div>

    <div class="adm-stats">
        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-rose">
                <i class="bi bi-grid-3x3-gap"></i>
            </div>
            <div>
                <div class="adm-stat-value">@totalCount</div>
                <div class="adm-stat-label">Toplam Masa</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-green">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="adm-stat-value">@availableCount</div>
                <div class="adm-stat-label">Müsait Masa</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-peach">
                <i class="bi bi-person-fill-lock"></i>
            </div>
            <div>
                <div class="adm-stat-value">@occupiedCount</div>
                <div class="adm-stat-label">Dolu Masa</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-blue">
                <i class="bi bi-pie-chart"></i>
            </div>
            <div>
                <div class="adm-stat-value">%@occupancyRate</div>
                <div class="adm-stat-label">Doluluk Oranı</div>
            </div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-toolbar">
            <div class="adm-input-icon">
                <i class="bi bi-search"></i>
                <input type="text" id="tableSearchInput" class="adm-input" placeholder="Masa no veya QR kod ara..." onkeyup="filterTables()" />
            </div>

            <div class="adm-segment" role="group" aria-label="Durum filtresi">
                <button type="button" class="active" onclick="setStatusFilter('all', this)">Tümü</button>
                <button type="button" onclick="setStatusFilter('available', this)">Müsait</button>
                <button type="button" onclick="setStatusFilter('occupied', this)">Dolu</button>
            </div>

            <div class="adm-counter">
                Toplam <strong id="visibleTableCount">@totalCount</strong> masa
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="adm-table-wrap">
                <table class="adm-table" id="tablesTable">
                    <thead>
                        <tr>
                            <th>Masa</th>
                            <th class="num">Masa No</th>
                            <th>QR Kod</th>
                            <th>Durum</th>
                            <th class="end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(x => x.TableNumber))
                        {
                            var statusKey = item.IsAvailable ? "available" : "occupied";
                            var qrText = item.QRCode ?? string.Empty;

                            <tr data-status="@statusKey" data-search="masa @item.TableNumber @qrText.ToLower()">
                                <td class="cell-main">
                                    <div class="adm-entity">
                                        <div class="adm-thumb">
                                            <i class="bi bi-qr-code"></i>
                                        </div>
                                        <div>
                                            <strong>Masa @item.TableNumber</strong>
                                            <small>ID: #@item.Id</small>
                                        </div>
                                    </div>
                                </td>

                                <td class="num" data-label="Masa No">
                                    <span class="adm-order">@item.TableNumber</span>
                                </td>

                                <td data-label="QR Kod">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <span class="adm-badge adm-badge-neutral no-dot">@qrText</span>
                                        <button type="button"
                                                class="adm-icon-btn bordered"
                                                onclick="copyQrCode('@qrText', this)"
                                                title="QR Kodunu Kopyala">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>

                                <td data-label="Durum">
                                    @if (item.IsAvailable)
                                    {
                                        <span class="adm-badge adm-badge-success">Müsait</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge adm-badge-inactive">Dolu</span>
                                    }
                                </td>

                                <td class="end cell-actions">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-area="Admin"
                                           asp-controller="Table"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="adm-icon-btn bordered"
                                           title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-area="Admin"
                                           asp-controller="Table"
                                           asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Masa @item.TableNumber kaydını silmek istediğinize emin misiniz?');"
                                           class="adm-icon-btn bordered text-danger"
                                           title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="adm-empty">
                <div class="adm-empty-art">
                    <i class="bi bi-qr-code"></i>
                </div>
                <h3>Henüz tanımlı masa bulunmuyor</h3>
                <p>Müşterilerin masadan QR kod okutarak sipariş verebilmesi için ilk masanızı oluşturun.</p>
                <a asp-area="Admin" asp-controller="Table" asp-action="Create" class="adm-btn adm-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    <span>Yeni Masa Ekle</span>
                </a>
            </div>
        }
    </div>
</div>

<script>
    let activeStatus = 'all';

    function setStatusFilter(status, btn) {
        activeStatus = status;
        document.querySelectorAll('.adm-segment button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterTables();
    }

    function filterTables() {
        const query = document.getElementById('tableSearchInput').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#tablesTable tbody tr');
        let visibleCount = 0;

        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            const rowText = row.getAttribute('data-search') || '';
            const matchesStatus = activeStatus === 'all' || rowStatus === activeStatus;
            const matchesText = rowText.includes(query);
            const isMatch = matchesStatus && matchesText;

            row.classList.toggle('d-none', !isMatch);
            if (isMatch) visibleCount++;
        });

        const counterEl = document.getElementById('visibleTableCount');
        if (counterEl) counterEl.textContent = visibleCount;
    }

    function copyQrCode(text, btn) {
        navigator.clipboard.writeText(text).then(() => {
            const icon = btn.querySelector('i');
            icon.className = 'bi bi-check2 text-success';
            setTimeout(() => {
                icon.className = 'bi bi-clipboard';
            }, 1500);
        });
    }
</script>