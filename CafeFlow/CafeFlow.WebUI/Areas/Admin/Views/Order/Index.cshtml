@using CafeFlow.DTO.Order
@using CafeFlow.Entity.Enums
@model List<OrderListDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Siparişler";

    int totalOrders = Model.Count;
    int pendingCount = Model.Count(x => x.OrderStatus == OrderStatus.Received);
    int preparingCount = Model.Count(x => x.OrderStatus == OrderStatus.Preparing);
    decimal totalRevenue = Model.Where(x => x.OrderStatus != OrderStatus.Cancelled).Sum(x => x.TotalAmount);
}

<div class="adm-content" style="max-width:100%;">

    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">Sipariş Listesi</h1>
            <p class="adm-page-sub">Gelen tüm siparişleri ve anlık durumlarını buradan takip edebilirsiniz.</p>
        </div>
        <div>
            <a href="/Admin/Order/Index" class="adm-btn adm-btn-light">
                <i class="bi bi-arrow-clockwise"></i> Listeyi Yenile
            </a>
        </div>
    </div>

    <div class="adm-stats">
        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-rose">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <div class="adm-stat-value">@totalOrders</div>
                <div class="adm-stat-label">Toplam Sipariş</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-peach">
                <i class="bi bi-bell"></i>
            </div>
            <div>
                <div class="adm-stat-value">@pendingCount</div>
                <div class="adm-stat-label">Yeni Alınan</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-blue">
                <i class="bi bi-fire"></i>
            </div>
            <div>
                <div class="adm-stat-value">@preparingCount</div>
                <div class="adm-stat-label">Hazırlanan</div>
            </div>
        </div>

        <div class="adm-stat">
            <div class="adm-stat-icon adm-tone-green">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <div class="adm-stat-value">₺@totalRevenue.ToString("N2")</div>
                <div class="adm-stat-label">Toplam Ciro</div>
            </div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-table-wrap">
            @if (Model.Any())
            {
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Sipariş Kodu</th>
                            <th>Müşteri Bilgisi</th>
                            <th>Sipariş Türü</th>
                            <th>Teslimat / Masa</th>
                            <th class="num">Tutar</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th class="end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Sipariş Kodu">
                                    <span class="adm-pill-num font-monospace fw-bold text-dark">
                                        #@item.OrderCode
                                    </span>
                                </td>

                                <td class="cell-main" data-label="Müşteri">
                                    <div class="adm-entity">
                                        <div class="adm-avatar">
                                            @(string.IsNullOrWhiteSpace(item.CustomerName) ? "M" : item.CustomerName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <strong>@(string.IsNullOrEmpty(item.CustomerName) ? "Misafir Müşteri" : item.CustomerName)</strong>
                                            <small>@(string.IsNullOrEmpty(item.PhoneNumber) ? "Telefon Yok" : item.PhoneNumber)</small>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Tür">
                                    @if (item.OrderType == OrderType.Online)
                                    {
                                        <span class="adm-badge adm-badge-info">
                                            <i class="bi bi-bicycle"></i> Adrese Teslim
                                        </span>
                                    }
                                    else if (item.OrderType == OrderType.Table)
                                    {
                                        <span class="adm-badge adm-badge-warning">
                                            <i class="bi bi-qr-code"></i> Masadan
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge adm-badge-neutral">
                                            <i class="bi bi-bag"></i> Gel-Al
                                        </span>
                                    }
                                </td>

                                <td class="cell-desc" data-label="Detay">
                                    @if (item.OrderType == OrderType.Table)
                                    {
                                        <span class="adm-order">Masa @(item.TableId?.ToString() ?? "—")</span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <span class="adm-desc" title="@item.Address">@item.Address</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="num" data-label="Tutar">
                                    <strong class="text-dark">₺@item.TotalAmount.ToString("N2")</strong>
                                </td>

                                <td data-label="Durum">
                                    @switch (item.OrderStatus)
                                    {
                                        case OrderStatus.Received:
                                            <span class="adm-badge adm-badge-warning">Alındı</span>
                                            break;
                                        case OrderStatus.Preparing:
                                            <span class="adm-badge adm-badge-info">Hazırlanıyor</span>
                                            break;
                                        case OrderStatus.Ready:
                                            <span class="adm-badge adm-badge-neutral">Hazır</span>
                                            break;
                                        case OrderStatus.Delivered:
                                            <span class="adm-badge adm-badge-success">Teslim Edildi</span>
                                            break;
                                        case OrderStatus.Cancelled:
                                            <span class="adm-badge adm-badge-inactive">İptal</span>
                                            break;
                                        default:
                                            <span class="adm-badge adm-badge-neutral">@item.OrderStatus</span>
                                            break;
                                    }
                                </td>

                                <td data-label="Tarih">
                                    <span class="adm-date">@item.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                                </td>

                                <td class="end cell-actions" data-label="İşlem">
                                    <a href="/Admin/Order/Detail/@item.Id" class="adm-btn adm-btn-light adm-btn-sm" title="Detay">
                                        <i class="bi bi-eye"></i> İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="adm-empty">
                    <div class="adm-empty-art">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <h3>Henüz Sipariş Yok</h3>
                    <p>Veritabanında kayıtlı herhangi bir sipariş bulunmuyor.</p>
                </div>
            }
        </div>
    </div>

</div>