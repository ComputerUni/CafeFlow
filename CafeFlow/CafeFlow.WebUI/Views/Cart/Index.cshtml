  const findProduct = (id) => PRODUCTS.find((p) => p.id === id);

  /* ---------- 2. CART-PAGE CONFIG ---------- */
  const PRICING = {
    deliveryFee: 30,          // ₺ per delivery order
    freeDeliveryFrom: 600,    // ₺ subtotal after discount
  };

  /** Simulated promo codes (frontend demo only, not validated by a server). */
  const PROMO_CODES = {
    SWEET10: { percent: 10, label: "10% off" },
    PINK20:  { percent: 20, label: "20% off" },
  };

  /**
   * Mock table registry. In production the QR token would be validated by the
   * server; the customer can never type a table number themselves.
   */
  const TABLE_REGISTRY = {
    "CF-T07-ROSE":  { tableNumber: 7,  area: "Garden Corner" },
    "CF-T12-PEACH": { tableNumber: 12, area: "Window Seats" },
  };

  const OPENING_HOURS = { 0: [9 * 60, 20 * 60], 6: [8 * 60 + 30, 22 * 60], default: [7 * 60 + 30, 21 * 60] };

  /** Sample lines for the optional preview. Never saved unless the customer chooses to. */
  const PREVIEW_LINES = [
    { productId: 7,  options: { size: "Large",  milk: "Oat",     extraShot: "Yes", syrup: "None" }, quantity: 1 },
    { productId: 10, options: null, quantity: 1 },
    { productId: 4,  options: { size: "Medium", milk: "Regular", extraShot: "No",  syrup: "None" }, quantity: 2 },
  ];

  /* ---------- 3. STORAGE + CART MODULE ---------- */
  const STORAGE_KEYS = {
    cart: "cafeflow_cart",                    // shared with Products Page
    favorites: "cafeflow_favorites",          // shared with Products Page
    tableContext: "cafeflow_table_context",   // set only by a validated QR scan
    orderDraft: "cafeflow_order_draft",       // order type, form values, note, promo
  };

  const storage = {
    read(key, fallback, store = localStorage) {
      try {
        const raw = store.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch { return fallback; }
    },
    write(key, value, store = localStorage) {
      try { store.setItem(key, JSON.stringify(value)); } catch { /* storage unavailable */ }
    },
    remove(key, store = localStorage) {
      try { store.removeItem(key); } catch { /* ignore */ }
    },
  };

  /** Unit price = base price + option extras (same rule as Products Page). */
  function priceWithOptions(product, options) {
    if (!options) return product.price;
    return product.price + CUSTOM_OPTIONS.reduce((sum, group) => {
      const choice = group.choices.find((c) => c.value === options[group.key]);
      return sum + (choice ? choice.price : 0);
    }, 0);
  }

  /**
   * Cart module — same data contract and storage key as the Products Page:
   * { lineId, productId, name, image, unitPrice, quantity, options }
   * In preview mode it works on an in-memory copy and never writes to storage.
   */
  const Cart = {
    items: [],
    preview: false,

    load() {
      const stored = storage.read(STORAGE_KEYS.cart, []);
      // Re-price lines from the catalog so the page always uses current prices.
      this.items = stored
        .filter((l) => findProduct(l.productId) && l.quantity > 0)
        .map((l) => {
          const product = findProduct(l.productId);
          return { ...l, name: product.name, image: product.image, unitPrice: priceWithOptions(product, l.options) };
        });
      this.preview = false;
    },
    startPreview() {
      this.preview = true;
      this.items = PREVIEW_LINES.map((l) => this.makeLine(findProduct(l.productId), l.options, l.quantity));
    },
    save() {
      if (!this.preview) storage.write(STORAGE_KEYS.cart, this.items);
      document.dispatchEvent(new CustomEvent("cart:changed"));
    },
    buildLineId(productId, options) {
      if (!options) return String(productId);
      return [productId, ...Object.entries(options).map(([k, v]) => `${k}:${v}`)].join("|");
    },
    makeLine(product, options, quantity = 1) {
      return {
        lineId: this.buildLineId(product.id, options),
        productId: product.id,
        name: product.name,
        image: product.image,
        unitPrice: priceWithOptions(product, options),
        quantity,
        options: options || null,
      };
    },
    get(lineId) { return this.items.find((l) => l.lineId === lineId); },
    add(product, { options = null, quantity = 1 } = {}) {
      const line = this.makeLine(product, options, quantity);
      const existing = this.get(line.lineId);
      if (existing) existing.quantity += quantity;
      else this.items.push(line);
      this.save();
    },
    setQuantity(lineId, quantity) {
      const line = this.get(lineId);
      if (!line) return;
      line.quantity = Math.max(1, Math.min(quantity, 50));
      this.save();
    },
    /** Replace a line's options; merges into an existing identical line if needed. */
    updateOptions(lineId, options, quantity) {
      const index = this.items.findIndex((l) => l.lineId === lineId);
      if (index === -1) return;
      const product = findProduct(this.items[index].productId);
      const updated = this.makeLine(product, options, quantity);
      const duplicate = this.items.find((l, i) => i !== index && l.lineId === updated.lineId);
      if (duplicate) {
        duplicate.quantity += updated.quantity;
        this.items.splice(index, 1);
      } else {
        this.items.splice(index, 1, updated);
      }
      this.save();
    },
    remove(lineId) {
      const index = this.items.findIndex((l) => l.lineId === lineId);
      if (index === -1) return null;
      const [removed] = this.items.splice(index, 1);
      this.save();
      return { line: removed, index };
    },
    restore({ line, index }) {
      this.items.splice(Math.min(index, this.items.length), 0, line);
      this.save();
    },
    clear() { this.items = []; this.save(); },
    count() { return this.items.reduce((s, l) => s + l.quantity, 0); },
    subtotal() { return this.items.reduce((s, l) => s + l.unitPrice * l.quantity, 0); },
    customizationTotal() {
      return this.items.reduce((s, l) => {
        const product = findProduct(l.productId);
        return s + (l.unitPrice - product.price) * l.quantity;
      }, 0);
    },
  };

  /* ---------- 4. UI HELPERS ---------- */
  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
  const round2 = (n) => Math.round(n * 100) / 100;
  const formatMoney = (n) => `₺${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const detailUrl = (id) => `product-detail.html?id=${id}`;
  const categoryLabel = (id) => (CATEGORIES.find((c) => c.id === id) || {}).label || "";
  const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  function attachImageFallback(img) {
    const swap = () => {
      const div = document.createElement("div");
      div.className = "cf-img-fallback";
      div.setAttribute("role", "img");
      div.setAttribute("aria-label", img.alt);
      div.innerHTML = `<i class="bi ${FALLBACK_ICON[img.dataset.fallback] || "bi-heart"}"></i>`;
      img.replaceWith(div);
    };
    if (img.complete && img.naturalWidth === 0 && img.getAttribute("src")) swap();
    else img.addEventListener("error", swap, { once: true });
  }
  const applyFallbacks = (root = document) => $$("img[data-fallback]", root).forEach(attachImageFallback);

  const toast = {
    el: $("#cfToast"),
    text: $("#cfToastText"),
    icon: $("#cfToastIcon"),
    action: $("#cfToastAction"),
    timer: null,
    onAction: null,
    show(message, { error = false, actionLabel = null, onAction = null, duration = 2600 } = {}) {
      this.text.textContent = message;
      this.el.classList.toggle("error", error);
      this.icon.className = `bi ${error ? "bi-exclamation-circle-fill" : "bi-check-circle-fill"}`;
      this.onAction = onAction;
      this.action.textContent = actionLabel || "";
      this.action.classList.toggle("show", Boolean(actionLabel));
      this.el.classList.add("show");
      clearTimeout(this.timer);
      this.timer = setTimeout(() => this.hide(), actionLabel ? 5000 : duration);
    },
    hide() {
      this.el.classList.remove("show");
      this.onAction = null;
    },
  };
  toast.action.addEventListener("click", () => {
    if (toast.onAction) toast.onAction();
    toast.hide();
  });

  /** Option tags shown under each cart line. */
  function optionTags(options) {
    if (!options) return "";
    const tags = [
      `<span class="cf-opt-tag"><i class="bi bi-cup"></i> ${options.size}</span>`,
      `<span class="cf-opt-tag"><i class="bi bi-droplet"></i> ${options.milk === "Regular" ? "Regular milk" : options.milk + " milk"}</span>`,
    ];
    if (options.extraShot === "Yes") tags.push(`<span class="cf-opt-tag"><i class="bi bi-lightning-charge"></i> Extra shot</span>`);
    if (options.syrup && options.syrup !== "None") tags.push(`<span class="cf-opt-tag"><i class="bi bi-stars"></i> ${options.syrup} syrup</span>`);
    return `<div class="cf-opt-tags">${tags.join("")}</div>`;
  }

  /* ---------- 5. CART ITEMS ---------- */
  const cartList = $("#cartList");
  const emptyCart = $("#emptyCart");
