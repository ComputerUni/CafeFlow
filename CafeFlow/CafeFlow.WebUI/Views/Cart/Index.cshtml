  /* ---------- 6. CUSTOMIZE / EDIT MODAL ---------- */
  const customizeModal = new bootstrap.Modal($("#customizeModal"));
  const customizeForm = $("#customizeForm");
  const modalQtyEl = $("#modalQty");
  const modalQtyDec = $("#modalQtyDec");
  const modalState = { product: null, lineId: null, qty: 1 };

  function readModalOptions() {
    const options = {};
    CUSTOM_OPTIONS.forEach((group) => {
      const input = customizeForm.querySelector(`input[name="${group.key}"]:checked`);
      options[group.key] = input ? input.value : group.default;
    });
    return options;
  }

  function updateModalTotal() {
    const unit = priceWithOptions(modalState.product, readModalOptions());
    $("#modalTotal").textContent = formatMoney(unit * modalState.qty);
    modalQtyEl.textContent = modalState.qty;
    modalQtyDec.disabled = modalState.qty <= 1;
  }

  /** Opens the modal to add a new product, or to edit an existing cart line (lineId). */
  function openCustomizer(product, { lineId = null } = {}) {
    const line = lineId ? Cart.get(lineId) : null;
    const current = line && line.options ? line.options : null;
    modalState.product = product;
    modalState.lineId = lineId;
    modalState.qty = line ? line.quantity : 1;

    $("#customizeTitle").textContent = product.name;
    $("#customizeDesc").textContent = product.description;
    $("#customizeCategory").textContent = categoryLabel(product.category);
    $("#customizeImage").innerHTML = `<img src="${product.image}" alt="${product.name}" data-fallback="${product.category}" />`;
    applyFallbacks($("#customizeImage"));
    $("#customizeSubmit").innerHTML = lineId
      ? `<i class="bi bi-check2"></i> Save Changes`
      : `<i class="bi bi-bag-plus"></i> Add to Cart`;

    $("#customizeOptions").innerHTML = CUSTOM_OPTIONS.map((group) => {
      const selected = current ? current[group.key] : group.default;
      return `
        <fieldset class="cf-opt-group">
          <legend class="cf-opt-label">${group.label}</legend>
          <div class="cf-opt-choices">
            ${group.choices.map((c) => `
              <label class="cf-opt">
                <input type="radio" name="${group.key}" value="${c.value}" ${c.value === selected ? "checked" : ""} />
                <span>${c.value}<small>${c.price ? `+${formatMoney(c.price)}` : "Included"}</small></span>
              </label>`).join("")}
          </div>
        </fieldset>`;
    }).join("");

    updateModalTotal();
    customizeModal.show();
  }

  customizeForm.addEventListener("change", updateModalTotal);
  $("#modalQtyInc").addEventListener("click", () => { modalState.qty = Math.min(modalState.qty + 1, 50); updateModalTotal(); });
  modalQtyDec.addEventListener("click", () => { modalState.qty = Math.max(modalState.qty - 1, 1); updateModalTotal(); });
  customizeForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const options = readModalOptions();
    const { product, lineId, qty } = modalState;
    if (lineId) {
      Cart.updateOptions(lineId, options, qty);
      toast.show(`${product.name} updated`);
    } else {
      Cart.add(product, { options, quantity: qty });
      toast.show(`${product.name} added to your cart`);
    }
    customizeModal.hide();
  });

  /* ---------- 7. ORDER TYPE & DETAILS ---------- */
  const detailsForm = $("#detailsForm");
  const typeInputs = $$('input[name="orderType"]');
  const draft = storage.read(STORAGE_KEYS.orderDraft, {}, sessionStorage);
  const orderState = {
    type: draft.type || null,
    promo: draft.promo || null,
    tableContext: storage.read(STORAGE_KEYS.tableContext, null, sessionStorage),
  };

  function saveDraft() {
    const fields = {};
    $$("input[name], textarea[name], select[name]", detailsForm).forEach((el) => {
      if (el.name !== "tableNumber") fields[el.name] = el.value;
    });
    storage.write(STORAGE_KEYS.orderDraft, {
      type: orderState.type,
      promo: orderState.promo,
      fields,
      note: $("#orderNote").value,
    }, sessionStorage);
  }

  /** Validates ?qr=TOKEN against the mock registry and stores the table context. */
  function resolveTableFromUrl() {
    const params = new URLSearchParams(location.search);
    const token = params.get("qr");
    if (!token) return;
    const entry = TABLE_REGISTRY[token.toUpperCase()];
    if (entry) {
      orderState.tableContext = { token: token.toUpperCase(), ...entry, validatedAt: new Date().toISOString() };
      storage.write(STORAGE_KEYS.tableContext, orderState.tableContext, sessionStorage);
      orderState.type = "dinein";
      setTimeout(() => toast.show(`Welcome to Table ${entry.tableNumber}! Dine-In is selected.`), 400);
    } else {
      setTimeout(() => toast.show("This table code isn't recognized. Please scan the QR on your table again.", { error: true }), 400);
    }
    // Remove the token from the address bar so it can't be edited or shared accidentally.
    params.delete("qr");
    const clean = location.pathname + (params.toString() ? `?${params}` : "") + location.hash;
    history.replaceState(null, "", clean);
  }

  function renderTableContext() {
    const ctx = orderState.tableContext;
    $("#tableVerified").classList.toggle("d-none", !ctx);
    $("#tableMissing").classList.toggle("d-none", Boolean(ctx));
    const badge = $("#dineInBadge");
    if (ctx) {
      $("#tableNumBig").textContent = ctx.tableNumber;
      $("#tableLabel").textContent = `Table ${ctx.tableNumber} · ${ctx.area}`;
      $("#tableNumber").value = `Table ${ctx.tableNumber}`;
      badge.className = "cf-type-badge";
      badge.innerHTML = `<i class="bi bi-patch-check-fill"></i> Table ${ctx.tableNumber}`;
    } else {
      badge.className = "cf-type-badge pending";
      badge.innerHTML = `<i class="bi bi-qr-code"></i> Table QR needed`;
    }
  }

  function renderOrderType() {
    typeInputs.forEach((input) => (input.checked = input.value === orderState.type));
    $$(".cf-field-group", detailsForm).forEach((group) => {
      const visible = orderState.type && group.dataset.for.split(" ").includes(orderState.type);
      group.classList.toggle("is-hidden", !visible);
      $$("input, textarea, select", group).forEach((el) => (el.tabIndex = visible ? 0 : -1));
    });
    $("#typeHint").classList.toggle("d-none", Boolean(orderState.type));

    const labels = {
      delivery: "Delivery to your door",
      pickup: "Pickup at 24 Blossom Street",
      dinein: orderState.tableContext ? `Dine-in · Table ${orderState.tableContext.tableNumber}` : "Dine-in · scan your table QR",
    };
    $("#summaryType").textContent = labels[orderState.type] || "Choose how you'd like your order";
  }

  typeInputs.forEach((input) =>
    input.addEventListener("change", () => {
      orderState.type = input.value;
      renderOrderType();
      renderTotals();
      saveDraft();
    })
  );

  /** Pickup slots: "As soon as possible" + every 15 min until closing (or tomorrow's first slots). */
  function buildPickupSlots() {
    const select = $("#pickupTime");
    const pad = (n) => String(n).padStart(2, "0");
    const fmt = (mins) => `${pad(Math.floor(mins / 60))}:${pad(mins % 60)}`;
    const now = new Date();
    const [open, close] = OPENING_HOURS[now.getDay()] || OPENING_HOURS.default;
    const nowMins = now.getHours() * 60 + now.getMinutes();
    let options = [`<option value="">Select a time</option>`];

    if (nowMins >= open && nowMins < close - 20) {
      options.push(`<option value="asap">As soon as possible (~15 min)</option>`);
      let start = Math.ceil((nowMins + 30) / 15) * 15;
      for (let t = start; t <= close - 15; t += 15) options.push(`<option value="today-${fmt(t)}">Today, ${fmt(t)}</option>`);
    } else {
      const tomorrow = new Date(now);
      tomorrow.setDate(now.getDate() + (nowMins >= open ? 1 : 0));
      const [tOpen, tClose] = OPENING_HOURS[tomorrow.getDay()] || OPENING_HOURS.default;
      const label = nowMins >= open ? "Tomorrow" : "Today";
      for (let t = tOpen + 15; t <= Math.min(tOpen + 4 * 60, tClose - 15); t += 15) {
        options.push(`<option value="${label.toLowerCase()}-${fmt(t)}">${label}, ${fmt(t)}</option>`);
      }
    }
    select.innerHTML = options.join("");
  }

  // Validation
  const validators = {
    phone: (v) => v.replace(/[^\d+]/g, "").replace(/^\+/, "").length >= 10,
    address: (v) => v.trim().length >= 10,
  };

  function validateField(el) {
    const requiredFor = (el.dataset.required || "").split(" ");
    if (!requiredFor.includes(orderState.type)) {
      el.classList.remove("is-invalid");
      return true;
    }
    const value = el.value.trim();
    let ok = value.length > 0;
    if (ok && el.dataset.validate) ok = validators[el.dataset.validate](value);
    el.classList.toggle("is-invalid", !ok);
    return ok;
  }

  $$("[data-required]", detailsForm).forEach((el) => {
    el.addEventListener("blur", () => { if (el.value) validateField(el); });
    el.addEventListener("input", () => { if (el.classList.contains("is-invalid")) validateField(el); });
  });
  detailsForm.addEventListener("input", saveDraft);
  detailsForm.addEventListener("change", saveDraft);
  detailsForm.addEventListener("submit", (e) => e.preventDefault());

  const noteEl = $("#orderNote");
  noteEl.addEventListener("input", () => {
    $("#noteCount").textContent = noteEl.value.length;
    saveDraft();
  });

  /* ---------- 8. PROMO CODE ---------- */
  const promoForm = $("#promoForm");
  const promoInput = $("#promoInput");
  const promoMsg = $("#promoMsg");

  function renderPromo() {
    const code = orderState.promo;
    $("#promoBox").classList.toggle("d-none", Boolean(code));
    $("#promoApplied").classList.toggle("d-none", !code);
    if (code) $("#promoAppliedText").textContent = `${code} · ${PROMO_CODES[code].label}`;
  }

  promoForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const code = promoInput.value.trim().toUpperCase();
    promoForm.classList.remove("is-invalid");
    promoMsg.className = "cf-promo-msg";

    if (!code) {
      promoMsg.textContent = "Please enter a code.";
      promoMsg.classList.add("err");
      promoForm.classList.add("is-invalid");
      return;
    }
    if (!PROMO_CODES[code]) {
      promoMsg.textContent = `"${code}" isn't a valid code. Try another one.`;
      promoMsg.classList.add("err");
      promoForm.classList.add("is-invalid");
      return;
    }
    orderState.promo = code;
    promoInput.value = "";
    promoMsg.textContent = "";
    renderPromo();
    renderTotals();
    saveDraft();
    toast.show(`${code} applied · ${PROMO_CODES[code].label}`);
  });

  $("#promoRemove").addEventListener("click", () => {
    const old = orderState.promo;
    orderState.promo = null;
    renderPromo();
    renderTotals();
    saveDraft();
    toast.show(`${old} removed`);
  });

  /* ---------- 9. TOTALS & SUMMARY ---------- */
  /** Single source of truth for all money calculations on the page. */
  function calculateTotals() {
    const subtotal = round2(Cart.subtotal());
    const customizations = round2(Cart.customizationTotal()); // already inside subtotal
    const percent = orderState.promo ? PROMO_CODES[orderState.promo].percent : 0;
    const discount = round2(Math.min(subtotal, subtotal * percent / 100));
    const afterDiscount = round2(subtotal - discount);
    let deliveryFee = 0;
    if (orderState.type === "delivery" && subtotal > 0) {
      deliveryFee = afterDiscount >= PRICING.freeDeliveryFrom ? 0 : PRICING.deliveryFee;
    }
    const total = Math.max(0, round2(afterDiscount + deliveryFee));
    return { subtotal, customizations, discount, afterDiscount, deliveryFee, total };
  }

  function renderTotals() {
    const t = calculateTotals();
    const empty = Cart.items.length === 0;

    $("#summaryItems").innerHTML = Cart.items.map((l) =>
      `<li><span>${l.quantity} × ${l.name}</span><span>${formatMoney(l.unitPrice * l.quantity)}</span></li>`
    ).join("");

    $("#sumSubtotal").textContent = empty ? "—" : formatMoney(t.subtotal);
    $("#sumCustomRow").classList.toggle("d-none", t.customizations <= 0);
    $("#sumCustom").textContent = formatMoney(t.customizations);
    $("#sumDiscount").textContent = t.discount > 0 ? `−${formatMoney(t.discount)}` : "—";

    const deliveryEl = $("#sumDelivery");
    deliveryEl.classList.remove("cf-free");
    if (empty || orderState.type !== "delivery") {
      deliveryEl.textContent = orderState.type && orderState.type !== "delivery" && !empty ? "Free" : "—";
      if (deliveryEl.textContent === "Free") deliveryEl.classList.add("cf-free");
    } else if (t.deliveryFee === 0) {
      deliveryEl.textContent = "Free";
      deliveryEl.classList.add("cf-free");
    } else {
      deliveryEl.textContent = formatMoney(t.deliveryFee);
    }

    $("#sumTotal").textContent = empty ? "—" : formatMoney(t.total);
    $("#mobileTotal").textContent = empty ? "—" : formatMoney(t.total);

    // Free-delivery hint
    const hint = $("#deliveryHint");
    const remaining = round2(PRICING.freeDeliveryFrom - t.afterDiscount);
    const pct = Math.min(100, (t.afterDiscount / PRICING.freeDeliveryFrom) * 100);
    hint.innerHTML = remaining > 0
      ? `<div class="w-100"><i class="bi bi-scooter"></i> Add <strong>${formatMoney(remaining)}</strong> more for free delivery (${formatMoney(PRICING.deliveryFee)} otherwise).<div class="cf-progress"><span style="width:${pct}%"></span></div></div>`
      : `<i class="bi bi-gift"></i> <span>Yay! Your order qualifies for <strong>free delivery</strong>.</span>`;

    // Checkout availability
    const checkoutBtn = $("#checkoutBtn");
    checkoutBtn.disabled = empty;
    $("#mobileCheckout").disabled = empty;
    $("#mobileBar").classList.toggle("hide", empty);
    document.body.classList.toggle("has-mobile-bar", !empty);
  }

  /* ---------- 10. CHECKOUT ---------- */
  const checkoutModal = new bootstrap.Modal($("#checkoutModal"));

  function validateOrder() {
    if (Cart.items.length === 0) {
      toast.show("Your cart is empty.", { error: true });
      return false;
    }
    if (Cart.preview) {
      toast.show("You're viewing sample items. Add them to your cart first.", { error: true });
      return false;
    }
    if (!orderState.type) {
      $("#orderTypePanel").scrollIntoView({ behavior: "smooth", block: "start" });
      toast.show("Please choose Delivery, Pickup or Dine-In.", { error: true });
      return false;
    }
    if (orderState.type === "dinein" && !orderState.tableContext) {
      $("#orderTypePanel").scrollIntoView({ behavior: "smooth", block: "start" });
      toast.show("Dine-in orders need a table QR scan.", { error: true });
      return false;
    }
    const fields = $$("[data-required]", detailsForm);
    const invalid = fields.filter((el) => !validateField(el));
    if (invalid.length) {
      invalid[0].scrollIntoView({ behavior: "smooth", block: "center" });
      setTimeout(() => invalid[0].focus({ preventScroll: true }), 350);
      toast.show("Please complete the highlighted details.", { error: true });
      return false;
    }
    return true;
  }

  function handleCheckout() {
    if (!validateOrder()) return;
    const t = calculateTotals();
    const typeLabel = {
      delivery: "Delivery",
      pickup: `Pickup · ${$("#pickupTime").selectedOptions[0]?.textContent || ""}`,
      dinein: `Dine-in · Table ${orderState.tableContext?.tableNumber}`,
    }[orderState.type];

    // Hand-off object for the future checkout page (frontend only).
    storage.write("cafeflow_checkout_request", {
      orderType: orderState.type,
      tableContext: orderState.type === "dinein" ? orderState.tableContext : null,
      items: Cart.items,
      promoCode: orderState.promo,
      totals: t,
      note: noteEl.value.trim(),
      createdAt: new Date().toISOString(),
    }, sessionStorage);

    $("#checkoutRecap").innerHTML = `
      <div><span>Order type</span><strong>${escapeHtml(typeLabel)}</strong></div>
      <div><span>Items</span><strong>${Cart.count()}</strong></div>
      ${t.discount ? `<div><span>Discount (${orderState.promo})</span><strong>−${formatMoney(t.discount)}</strong></div>` : ""}
      <div><span>Total</span><strong>${formatMoney(t.total)}</strong></div>`;
    checkoutModal.show();
  }

  $("#checkoutBtn").addEventListener("click", handleCheckout);
  $("#mobileCheckout").addEventListener("click", handleCheckout);

  /* ---------- RECOMMENDATIONS ---------- */
  function renderRecommendations() {
    const inCart = new Set(Cart.items.map((l) => l.productId));
    const cartCats = new Set(Cart.items.map((l) => findProduct(l.productId).category));
    // Prefer popular items from categories not yet in the cart (e.g. a cake for a coffee order).
    const picks = PRODUCTS
      .filter((p) => !inCart.has(p.id))
      .sort((a, b) => (cartCats.has(a.category) - cartCats.has(b.category)) || (b.popularity - a.popularity))
      .slice(0, 3);

    $("#recoSection").classList.toggle("d-none", picks.length === 0);
    $("#recoGrid").innerHTML = picks.map((p) => `
      <div class="col-sm-6 col-md-4">
        <article class="cf-product-card">
          <div class="cf-product-img">
            <a href="${detailUrl(p.id)}" class="cf-product-img-link" aria-label="View ${p.name} details">
              <img src="${p.image}" alt="${p.name}" loading="lazy" data-fallback="${p.category}" />
            </a>
            ${p.badge ? `<span class="cf-tag ${BADGES[p.badge]}">${p.badge}</span>` : ""}
          </div>
          <div class="cf-product-body">
            <span class="cf-cat-label mb-1">${categoryLabel(p.category)}</span>
            <h3><a href="${detailUrl(p.id)}">${p.name}</a></h3>
            <p>${p.description}</p>
            <div class="cf-product-foot">
              <span class="cf-price">${p.customizable ? "<small>from</small>" : ""}${formatMoney(p.price)}</span>
              <button type="button" class="btn cf-add-btn" data-reco="${p.id}">
                ${p.customizable ? '<i class="bi bi-sliders"></i> Customize' : '<i class="bi bi-bag-plus"></i> Add'}
              </button>
            </div>
          </div>
        </article>
      </div>`).join("");
    applyFallbacks($("#recoGrid"));
  }

  $("#recoGrid").addEventListener("click", (e) => {
    const btn = e.target.closest("[data-reco]");
    if (!btn) return;
    const product = findProduct(Number(btn.dataset.reco));
    if (product.customizable) openCustomizer(product);
    else {
      Cart.add(product);
      toast.show(`${product.name} added to your cart`);
    }
  });

  /* ---------- 11. PAGE BOOTSTRAP ---------- */
  function renderAll() {
    renderItems();
    renderTotals();
    renderRecommendations();
    renderNavCount();
  }
  document.addEventListener("cart:changed", renderAll);

  // Sync if the cart changes in another tab (e.g. Products Page)
  window.addEventListener("storage", (e) => {
    if (e.key === STORAGE_KEYS.cart && !Cart.preview) {
      Cart.load();
      renderAll();
    }
  });

  // Navbar behaviour (same as other pages)
  const nav = $("#mainNav");
  const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 30);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  const navCollapse = $("#navLinks");
  $$(".nav-link", navCollapse).forEach((link) =>
    link.addEventListener("click", () => {
      if (navCollapse.classList.contains("show")) bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
    })
  );

  // Newsletter
  $("#newsletterForm").addEventListener("submit", (e) => {
    e.preventDefault();
    e.target.reset();
    toast.show("Thanks! You're on the sweet list.");
  });

  // Open / closed status + year
  const now = new Date();
  const [open, close] = OPENING_HOURS[now.getDay()] || OPENING_HOURS.default;
  const mins = now.getHours() * 60 + now.getMinutes();
  if (mins < open || mins >= close) {
    const status = $("#openStatus");
    status.classList.add("closed");
    status.innerHTML = '<span class="cf-dot"></span> Closed now';
  }
  $("#year").textContent = now.getFullYear();

  // Initial state
  resolveTableFromUrl();
  buildPickupSlots();
  if (draft.fields) {
    Object.entries(draft.fields).forEach(([name, value]) => {
      const el = detailsForm.elements.namedItem(name);
      if (el && !el.readOnly) el.value = value;
    });
  }
  if (draft.note) { noteEl.value = draft.note; $("#noteCount").textContent = draft.note.length; }
  if (orderState.promo && !PROMO_CODES[orderState.promo]) orderState.promo = null;
  if (orderState.type === "dinein" && !orderState.tableContext && !draft.type) orderState.type = null;

  Cart.load();
  renderTableContext();
  renderOrderType();
  renderPromo();
  renderAll();
  saveDraft();
})();
  </script>
</body>
</html>
