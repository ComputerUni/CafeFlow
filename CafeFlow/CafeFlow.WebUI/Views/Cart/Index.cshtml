  function removeLine(lineId) {
    const card = cartList.querySelector(`[data-line="${CSS.escape(lineId)}"]`);
    const doRemove = () => {
      const removed = Cart.remove(lineId);
      if (!removed) return;
      toast.show(`${removed.line.name} removed from your cart`, {
        actionLabel: "Undo",
        onAction: () => {
          Cart.restore(removed);
          toast.show(`${removed.line.name} is back in your cart`);
        },
      });
    };
    if (card) {
      card.classList.add("removing");
      setTimeout(doRemove, 250);
    } else doRemove();
  }

  // Confirmation before a line reaches zero
  const confirmModal = new bootstrap.Modal($("#confirmModal"));
  let pendingRemoval = null;
  function askRemove(lineId) {
    const line = Cart.get(lineId);
    if (!line) return;
    pendingRemoval = lineId;
    $("#confirmTitle").textContent = `Remove ${line.name}?`;
    confirmModal.show();
  }
  $("#confirmYes").addEventListener("click", () => {
    confirmModal.hide();
    if (pendingRemoval) removeLine(pendingRemoval);
    pendingRemoval = null;
  });

  cartList.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-action]");
    if (!btn) return;
    const lineId = btn.closest("[data-line]").dataset.line;
    const line = Cart.get(lineId);
    if (!line) return;

    switch (btn.dataset.action) {
      case "inc":
        Cart.setQuantity(lineId, line.quantity + 1);
        break;
      case "dec":
        if (line.quantity <= 1) askRemove(lineId);
        else Cart.setQuantity(lineId, line.quantity - 1);
        break;
      case "remove":
        removeLine(lineId);
        break;
      case "edit":
        openCustomizer(findProduct(line.productId), { lineId });
        break;
    }
  });

  $("#clearCartBtn").addEventListener("click", () => {
    const snapshot = Cart.items.map((l) => ({ ...l }));
    Cart.clear();
    toast.show("Your cart has been cleared", {
      actionLabel: "Undo",
      onAction: () => { Cart.items = snapshot; Cart.save(); },
    });
  });

  // Preview mode
  $("#previewStart").addEventListener("click", () => {
    Cart.startPreview();
    document.dispatchEvent(new CustomEvent("cart:changed"));
    toast.show("Showing sample items. Nothing is saved.");
  });
  $("#previewExit").addEventListener("click", () => {
    Cart.load();
    document.dispatchEvent(new CustomEvent("cart:changed"));
  });
  $("#previewKeep").addEventListener("click", () => {
    Cart.preview = false;
