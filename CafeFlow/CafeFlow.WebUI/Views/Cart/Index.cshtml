  /** Option groups for customizable drinks. `price` is added to the base price. */
  const CUSTOM_OPTIONS = [
    { key: "size", label: "Size", choices: [
      { value: "Small",  price: 0 },
      { value: "Medium", price: 15 },
      { value: "Large",  price: 30 },
    ], default: "Medium" },
    { key: "milk", label: "Milk", choices: [
      { value: "Regular", price: 0 },
      { value: "Oat",     price: 15 },
      { value: "Almond",  price: 15 },
    ], default: "Regular" },
    { key: "extraShot", label: "Extra Espresso Shot", choices: [
      { value: "No",  price: 0 },
      { value: "Yes", price: 20 },
    ], default: "No" },
    { key: "syrup", label: "Additional Syrup", choices: [
      { value: "None",    price: 0 },
      { value: "Vanilla", price: 10 },
      { value: "Caramel", price: 10 },
    ], default: "None" },
