@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_CartLayoutHead")

<body>

    @await Component.InvokeAsync("_CartLayoutPageHeader")

    <main class="cf-cart-section">
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-8">

                    <section class="cf-panel" aria-labelledby="itemsTitle">
                        <div class="cf-panel-head">
                            <h2 class="cf-panel-title" id="itemsTitle">
                                <span class="cf-step">1</span> Seçtiğiniz Lezzetler <small class="text-muted fs-6 fw-normal" id="itemsCount"></small>
                            </h2>
                            <button type="button" class="cf-clear-btn d-none" id="clearCartBtn"><i class="bi bi-trash3"></i> Sepeti Temizle</button>
                        </div>

                        <div id="cartList"></div>

                        <div class="cf-empty-cart d-none" id="emptyCart">
                            <div class="cf-empty-art" aria-hidden="true">
                                <span class="cf-empty-circle"></span>
                                <span class="cf-empty-main"><i class="bi bi-bag-heart"></i></span>
                                <span class="cf-empty-mini one"><i class="bi bi-cup-hot"></i></span>
                                <span class="cf-empty-mini two"><i class="bi bi-cake2"></i></span>
                            </div>
                            <h2>Sepetiniz biraz boş görünüyor...</h2>
                            <p>Hemen enfes bir kahve veya tatlıyla dolduralım!</p>
                            <a href="/Menu/Index" class="btn cf-btn-primary cf-btn-lg">Menüyü İncele <i class="bi bi-arrow-right"></i></a>
                        </div>

                        <a href="/Menu/Index" class="cf-continue" id="continueShopping"><span><i class="bi bi-arrow-left"></i></span> Alışverişe Devam Et</a>
                    </section>

                    <section class="cf-panel" id="orderTypePanel" aria-labelledby="typeTitle">
                        <div class="cf-panel-head">
                            <h2 class="cf-panel-title" id="typeTitle"><span class="cf-step">2</span> Siparişinizi Nasıl Almak İstersiniz?</h2>
                        </div>

                        <div class="cf-type-grid" role="radiogroup" aria-labelledby="typeTitle">
                            <label class="cf-type">
                                <input type="radio" name="orderType" value="delivery" />
                                <span class="cf-type-card">
                                    <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                                    <span class="cf-type-icon"><i class="bi bi-scooter"></i></span>
                                    <span class="cf-type-text">
                                        <span class="cf-type-name">Adrese Teslimat</span>
                                        <span class="cf-type-desc">Sıcak ve taze, kapınıza kadar gelsin.</span>
                                    </span>
                                </span>
                            </label>
                            <label class="cf-type">
                                <input type="radio" name="orderType" value="pickup" />
                                <span class="cf-type-card">
                                    <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                                    <span class="cf-type-icon"><i class="bi bi-bag"></i></span>
                                    <span class="cf-type-text">
                                        <span class="cf-type-name">Gel-Al</span>
                                        <span class="cf-type-desc">Önceden sipariş verin, sıra beklemeden teslim alın.</span>
                                    </span>
                                </span>
                            </label>
                            <label class="cf-type">
                                <input type="radio" name="orderType" value="dinein" />
                                <span class="cf-type-card">
                                    <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                                    <span class="cf-type-icon"><i class="bi bi-cup-hot"></i></span>
                                    <span class="cf-type-text">
                                        <span class="cf-type-name">Masadan Sipariş</span>
                                        <span class="cf-type-desc">Kafemizde masanızdan doğrudan sipariş verin.</span>
                                        <span class="cf-type-badge pending" id="dineInBadge"><i class="bi bi-qr-code"></i> Masa QR Gerekli</span>
                                    </span>
                                </span>
                            </label>
                        </div>

                        <form class="cf-details" id="detailsForm" novalidate>
                            <div class="cf-field-group is-hidden" data-for="delivery pickup">
                                <div>
                                    <div class="row g-3 pb-3">
                                        <div class="col-md-6">
                                            <label class="cf-label" for="fullName">Ad Soyad</label>
                                            <input class="cf-input" id="fullName" name="fullName" type="text" autocomplete="name" placeholder="Örn: Elif Yılmaz" data-required="delivery pickup" />
                                            <div class="cf-error">Lütfen adınızı ve soyadınızı giriniz.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="cf-label" for="phone">Telefon Numarası</label>
                                            <input class="cf-input" id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="05xx xxx xx xx" data-required="delivery pickup" data-validate="phone" />
                                            <div class="cf-error">Lütfen geçerli bir telefon numarası giriniz.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="cf-field-group is-hidden" data-for="delivery">
                                <div>
                                    <div class="row g-3 pb-3">
                                        <div class="col-12">
                                            <label class="cf-label" for="address">Teslimat Adresi</label>
                                            <textarea class="cf-textarea" id="address" name="address" rows="2" autocomplete="street-address" placeholder="Sokak, bina, daire, mahalle..." data-required="delivery" data-validate="address"></textarea>
                                            <div class="cf-error">Lütfen açık adresinizi belirtiniz.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="cf-label" for="addressNotes">Adres Tarifi / Notu <span class="opt">(isteğe bağlı)</span></label>
                                            <input class="cf-input" id="addressNotes" name="addressNotes" type="text" placeholder="Kapı zili, kat, blok vb." />
                                        </div>
                                    </div>
                                    <div class="cf-fee-hint" id="deliveryHint"></div>
                                </div>
                            </div>

                            <div class="cf-field-group is-hidden" data-for="pickup">
                                <div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="cf-label" for="pickupTime">Teslim Alma Saati</label>
                                            <select class="cf-input" id="pickupTime" name="pickupTime" data-required="pickup"></select>
                                            <div class="cf-error">Lütfen bir teslim alma saati seçiniz.</div>
                                        </div>
                                        <div class="col-md-6 d-flex align-items-end">
                                            <div class="cf-fee-hint w-100 mt-0"><i class="bi bi-geo-alt"></i> CafeFlow Teslim Noktası</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="cf-field-group is-hidden" data-for="dinein">
                                <div>
                                    <div id="tableVerified" class="d-none">
                                        <div class="cf-table-card">
                                            <span class="cf-table-num" id="tableNumBig">1</span>
                                            <div>
                                                <small>Sipariş verdiğiniz yer</small>
                                                <strong id="tableLabel">Masa 1</strong><br />
                                                <span class="cf-verified"><i class="bi bi-patch-check-fill"></i> Doğrulandı</span>
                                                <br />
                                                <button type="button" class="cf-link-btn mt-1" id="changeTableBtn">
                                                    <i class="bi bi-arrow-left-right"></i> Masa Değiştir
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row g-3 mt-1">
                                            <div class="col-12">
                                                <label class="cf-label" for="tableCustomerName">Ad Soyad</label>
                                                <input class="cf-input" id="tableCustomerName" name="tableCustomerName" type="text" placeholder="Örn: Mehmet Yılmaz" data-required="dinein" />
                                                <div class="cf-error">Lütfen adınızı ve soyadınızı giriniz.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="tableMissing" class="cf-notice">
                                        <i class="bi bi-qr-code-scan"></i>
                                        <div>
                                            <strong>Masanızı Seçin</strong>
                                            <p class="mb-2">Lütfen oturduğunuz masayı seçiniz.</p>
                                            <select class="cf-input mt-2" id="tableSelect">
                                                <option value="">— Masa seçiniz —</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-muted small mb-0" id="typeHint"><i class="bi bi-hand-index"></i> Devam etmek için yukarıdan bir sipariş türü seçin.</p>
                        </form>
                    </section>

                    <section class="cf-panel" aria-labelledby="noteTitle">
                        <div class="cf-panel-head">
                            <h2 class="cf-panel-title" id="noteTitle"><span class="cf-step">3</span> Baristamıza Bir Notunuz Var mı?</h2>
                        </div>
                        <label class="visually-hidden" for="orderNote">Sipariş Notu</label>
                        <textarea class="cf-textarea" id="orderNote" rows="3" maxlength="300" placeholder="Az şekerli, bol buzlu veya ek peçete gibi özel isteklerinizi yazabilirsiniz..."></textarea>
                        <div class="text-end small text-muted mt-1"><span id="noteCount">0</span>/300</div>
                    </section>

                    <section class="cf-reco" id="recoSection" aria-labelledby="recoTitle">
                        <h2 class="cf-reco-title" id="recoTitle">Bunları da Çok Seveceksiniz</h2>
                        <div class="row g-4" id="recoGrid"></div>
                    </section>
                </div>

                <div class="col-lg-4">
                    <div class="cf-summary-wrap">
                        <aside class="cf-summary" aria-labelledby="summaryTitle">
                            <div class="cf-summary-head">
                                <h2 id="summaryTitle">Sipariş Özeti</h2>
                                <p id="summaryType">Sipariş türünü seçiniz</p>
                            </div>
                            <div class="cf-summary-body">
                                <ul class="cf-summary-items" id="summaryItems"></ul>

                                <ul class="cf-sum-rows">
                                    <li><span>Ara Toplam</span><span id="sumSubtotal">₺0,00</span></li>
                                    <li class="cf-sum-sub" id="sumCustomRow"><span>özelleştirmeler dahil</span><span id="sumCustom">₺0,00</span></li>
                                    <li class="cf-sum-discount"><span>İndirim</span><span id="sumDiscount">−₺0,00</span></li>
                                    <li><span>Teslimat Ücreti</span><span id="sumDelivery">—</span></li>
                                </ul>

                                <div class="cf-grand">
                                    <span>Toplam<small>KDV Dahil</small></span>
                                    <strong id="sumTotal">₺0,00</strong>
                                </div>

                                <button type="button" class="btn cf-btn-primary cf-btn-lg w-100 cf-checkout-btn" id="checkoutBtn">
                                    <i class="bi bi-lock"></i> Siparişi Onayla
                                </button>

                                <div class="cf-secure">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Güvenli Sipariş. Ödeme işlemi öncesi tüm detayları inceleyebilirsiniz.</span>
                                </div>
                            </div>
                        </aside>

                        <div class="cf-perks">
                            <div class="cf-perk"><i class="bi bi-cup-hot"></i>Taze Hazırlanır</div>
                            <div class="cf-perk"><i class="bi bi-clock-history"></i>~15 Dk Hazır</div>
                            <div class="cf-perk"><i class="bi bi-heart"></i>Özenle Paketlenir</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="cf-mobile-bar hide" id="mobileBar">
        <div>
            <small>Toplam</small>
            <strong id="mobileTotal">₺0,00</strong>
        </div>
        <button type="button" class="btn cf-btn-primary" id="mobileCheckout">Siparişi Tamamla <i class="bi bi-arrow-right"></i></button>
    </div>

    @await Component.InvokeAsync("_CartLayoutFooter")

    @await Component.InvokeAsync("_CartLayoutCustomizeModal")

    @await Component.InvokeAsync("_CartLayoutCartModals")

    @await Component.InvokeAsync("_CartLayoutScripts")
</body>
</html>
