@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_CartLayoutHead")
<body>

  <!-- ============ PAGE HEADER ============ -->
  <header class="cf-page-header cf-compact">
    <div class="cf-blob cf-blob-1"></div>
    <div class="cf-blob cf-blob-2"></div>
    <span class="cf-deco cf-deco-1" aria-hidden="true"><i class="bi bi-bag-heart"></i></span>
    <span class="cf-deco cf-deco-2" aria-hidden="true"><i class="bi bi-flower1"></i></span>
    <span class="cf-deco cf-deco-3" aria-hidden="true"><i class="bi bi-cup-hot"></i></span>
    <span class="cf-deco cf-deco-4" aria-hidden="true"><i class="bi bi-heart"></i></span>

    <div class="container position-relative">
      <nav aria-label="Breadcrumb">
        <div class="cf-breadcrumb">
          <a href="index.html"><i class="bi bi-house-heart"></i> Home</a>
          <i class="bi bi-chevron-right"></i>
          <a href="products.html">Menu</a>
          <i class="bi bi-chevron-right"></i>
          <span aria-current="page">Your Cart</span>
        </div>
      </nav>
      <h1 class="cf-page-title">Your Sweet <em>Cart</em></h1>
      <p class="cf-page-sub">Your favorite little treats are almost on their way!</p>
    </div>
  </header>

  <!-- ============ CART ============ -->
  <main class="cf-cart-section">
    <div class="container">
      <div class="row g-4">

        <!-- LEFT: items + order type + note -->
        <div class="col-lg-8">

          <!-- Cart items -->
          <section class="cf-panel" aria-labelledby="itemsTitle">
            <div class="cf-panel-head">
              <h2 class="cf-panel-title" id="itemsTitle"><span class="cf-step">1</span> Your Treats <small class="text-muted fs-6 fw-normal" id="itemsCount"></small></h2>
              <button type="button" class="cf-clear-btn d-none" id="clearCartBtn"><i class="bi bi-trash3"></i> Clear cart</button>
            </div>

            <div class="cf-preview-banner d-none" id="previewBanner" role="status">
              <i class="bi bi-eye"></i>
              <p><strong>Preview mode</strong>These are sample items to show how your cart looks. Nothing is saved until you add them.</p>
              <button type="button" class="btn cf-btn-dark" id="previewKeep">Add these to my cart</button>
              <button type="button" class="btn cf-btn-outline" id="previewExit">Exit preview</button>
            </div>

            <div id="cartList"></div>

            <!-- Empty state -->
            <div class="cf-empty-cart d-none" id="emptyCart">
              <div class="cf-empty-art" aria-hidden="true">
                <span class="cf-empty-circle"></span>
                <span class="cf-empty-main"><i class="bi bi-bag-heart"></i></span>
                <span class="cf-empty-mini one"><i class="bi bi-cup-hot"></i></span>
                <span class="cf-empty-mini two"><i class="bi bi-cake2"></i></span>
              </div>
              <h2>Your cart feels a little lonely...</h2>
              <p>Let's fill it with something sweet!</p>
              <a href="products.html" class="btn cf-btn-primary cf-btn-lg">Explore Our Menu <i class="bi bi-arrow-right"></i></a>
              <div><button type="button" class="cf-preview-link" id="previewStart">Just looking? Preview the cart with sample items</button></div>
            </div>

            <a href="products.html" class="cf-continue" id="continueShopping"><span><i class="bi bi-arrow-left"></i></span> Continue Shopping</a>
          </section>

          <!-- Order type -->
          <section class="cf-panel" id="orderTypePanel" aria-labelledby="typeTitle">
            <div class="cf-panel-head">
              <h2 class="cf-panel-title" id="typeTitle"><span class="cf-step">2</span> How Would You Like to Enjoy Your Order?</h2>
            </div>

            <div class="cf-type-grid" role="radiogroup" aria-labelledby="typeTitle">
              <label class="cf-type">
                <input type="radio" name="orderType" value="delivery" />
                <span class="cf-type-card">
                  <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                  <span class="cf-type-icon"><i class="bi bi-scooter"></i></span>
                  <span class="cf-type-text">
                    <span class="cf-type-name">Delivery</span>
                    <span class="cf-type-desc">Your favorites, delivered to your doorstep.</span>
                  </span>
                </span>
              </label>
              <label class="cf-type">
                <input type="radio" name="orderType" value="pickup" />
                <span class="cf-type-card">
                  <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                  <span class="cf-type-icon"><i class="bi bi-bag"></i></span>
                  <span class="cf-type-text">
                    <span class="cf-type-name">Pickup</span>
                    <span class="cf-type-desc">Order ahead and pick up when you're ready.</span>
                  </span>
                </span>
              </label>
              <label class="cf-type">
                <input type="radio" name="orderType" value="dinein" />
                <span class="cf-type-card">
                  <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                  <span class="cf-type-icon"><i class="bi bi-cup-hot"></i></span>
                  <span class="cf-type-text">
                    <span class="cf-type-name">Dine-In</span>
                    <span class="cf-type-desc">Ordering from your favorite spot in our cafe.</span>
                    <span class="cf-type-badge pending" id="dineInBadge"><i class="bi bi-qr-code"></i> Table QR needed</span>
                  </span>
                </span>
              </label>
            </div>

            <form class="cf-details" id="detailsForm" novalidate>
              <!-- Shared contact fields (delivery + pickup) -->
              <div class="cf-field-group is-hidden" data-for="delivery pickup">
                <div>
                  <div class="row g-3 pb-3">
                    <div class="col-md-6">
                      <label class="cf-label" for="fullName">Full Name</label>
                      <input class="cf-input" id="fullName" name="fullName" type="text" autocomplete="name" placeholder="e.g. Elif Yılmaz" data-required="delivery pickup" />
                      <div class="cf-error">Please enter your full name.</div>
                    </div>
                    <div class="col-md-6">
                      <label class="cf-label" for="phone">Phone Number</label>
                      <input class="cf-input" id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="05xx xxx xx xx" data-required="delivery pickup" data-validate="phone" />
                      <div class="cf-error">Please enter a valid phone number.</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Delivery only -->
              <div class="cf-field-group is-hidden" data-for="delivery">
                <div>
                  <div class="row g-3 pb-3">
                    <div class="col-12">
                      <label class="cf-label" for="address">Delivery Address</label>
                      <textarea class="cf-textarea" id="address" name="address" rows="2" autocomplete="street-address" placeholder="Street, building, apartment, district" data-required="delivery" data-validate="address"></textarea>
                      <div class="cf-error">Please enter your full delivery address.</div>
                    </div>
                    <div class="col-12">
                      <label class="cf-label" for="addressNotes">Address Notes <span class="opt">(optional)</span></label>
                      <input class="cf-input" id="addressNotes" name="addressNotes" type="text" placeholder="Door code, floor, landmark..." />
                    </div>
                  </div>
                  <div class="cf-fee-hint" id="deliveryHint"></div>
                </div>
              </div>

              <!-- Pickup only -->
              <div class="cf-field-group is-hidden" data-for="pickup">
                <div>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="cf-label" for="pickupTime">Preferred Pickup Time</label>
                      <select class="cf-input" id="pickupTime" name="pickupTime" data-required="pickup"></select>
                      <div class="cf-error">Please choose a pickup time.</div>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                      <div class="cf-fee-hint w-100 mt-0"><i class="bi bi-geo-alt"></i> Pickup counter · 24 Blossom Street</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Dine-in only -->
              <div class="cf-field-group is-hidden" data-for="dinein">
                <div>
                  <div id="tableVerified" class="d-none">
                    <div class="cf-table-card">
                      <span class="cf-table-num" id="tableNumBig">7</span>
                      <div>
                        <small>You're ordering from</small>
                        <strong id="tableLabel">Table 7 · Garden Corner</strong><br />
                        <span class="cf-verified"><i class="bi bi-patch-check-fill"></i> Verified by table QR code</span>
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="cf-label" for="tableNumber">Table Number</label>
                        <input class="cf-input" id="tableNumber" name="tableNumber" type="text" readonly aria-readonly="true" />
                      </div>
                      <div class="col-md-8">
                        <label class="cf-label" for="dineNote">Note for Your Table <span class="opt">(optional)</span></label>
                        <input class="cf-input" id="dineNote" name="dineNote" type="text" placeholder="e.g. Please bring the cake with the coffee" />
                      </div>
                    </div>
                  </div>

                  <div id="tableMissing" class="cf-notice">
                    <i class="bi bi-qr-code-scan"></i>
                    <div>
                      <strong>Scan the QR code on your table</strong>
                      Dine-in orders are linked to your table automatically when you scan its QR code, so we always know where to bring your treats.
                      <div><a href="cart.html?qr=CF-T07-ROSE" class="cf-text-link">Simulate a table scan (demo) <i class="bi bi-arrow-right"></i></a></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Nothing selected yet -->
              <p class="text-muted small mb-0" id="typeHint"><i class="bi bi-hand-index"></i> Choose an option above to continue.</p>
            </form>
          </section>

          <!-- Special instructions -->
          <section class="cf-panel" aria-labelledby="noteTitle">
            <div class="cf-panel-head">
              <h2 class="cf-panel-title" id="noteTitle"><span class="cf-step">3</span> Anything We Should Know?</h2>
            </div>
            <label class="visually-hidden" for="orderNote">Special instructions</label>
            <textarea class="cf-textarea" id="orderNote" rows="3" maxlength="300" placeholder="Less sugar, extra napkins, or a little note for our baristas..."></textarea>
            <div class="text-end small text-muted mt-1"><span id="noteCount">0</span>/300</div>
          </section>

          <!-- Recommendations -->
          <section class="cf-reco" id="recoSection" aria-labelledby="recoTitle">
            <h2 class="cf-reco-title" id="recoTitle">You Might Also Love</h2>
            <div class="row g-4" id="recoGrid"></div>
          </section>
        </div>

        <!-- RIGHT: summary -->
        <div class="col-lg-4">
          <div class="cf-summary-wrap">
            <aside class="cf-summary" aria-labelledby="summaryTitle">
              <div class="cf-summary-head">
                <h2 id="summaryTitle">Order Summary</h2>
                <p id="summaryType">Choose how you'd like your order</p>
              </div>
              <div class="cf-summary-body">
                <ul class="cf-summary-items" id="summaryItems"></ul>

                <div id="promoBox">
                  <form class="cf-promo-form" id="promoForm" novalidate>
                    <label for="promoInput" class="visually-hidden">Promo code</label>
                    <input type="text" id="promoInput" placeholder="Enter your sweet code" autocomplete="off" maxlength="20" />
                    <button type="submit" class="btn cf-btn-primary">Apply</button>
                  </form>
                  <p class="cf-promo-msg" id="promoMsg" aria-live="polite"></p>
                </div>
                <div class="cf-promo-applied d-none" id="promoApplied">
                  <span><i class="bi bi-ticket-perforated"></i> <span id="promoAppliedText">SWEET10 · 10% off</span></span>
                  <button type="button" id="promoRemove">Remove</button>
                </div>
                <p class="cf-promo-hint">Demo codes: SWEET10 or PINK20. Final discount is confirmed at checkout.</p>

                <ul class="cf-sum-rows">
                  <li><span>Subtotal</span><span id="sumSubtotal">₺0.00</span></li>
                  <li class="cf-sum-sub" id="sumCustomRow"><span>incl. customizations</span><span id="sumCustom">₺0.00</span></li>
                  <li class="cf-sum-discount"><span>Discount</span><span id="sumDiscount">−₺0.00</span></li>
                  <li><span>Delivery Fee</span><span id="sumDelivery">—</span></li>
                </ul>

                <div class="cf-grand">
                  <span>Total<small>VAT included</small></span>
                  <strong id="sumTotal">₺0.00</strong>
                </div>

                <button type="button" class="btn cf-btn-primary cf-btn-lg w-100 cf-checkout-btn" id="checkoutBtn">
                  <i class="bi bi-lock"></i> Continue to Checkout
                </button>

                <div class="cf-secure">
                  <i class="bi bi-shield-check"></i>
                  <span>Secure order. You'll review everything before any payment is taken.</span>
                </div>
              </div>
            </aside>

            <div class="cf-perks">
              <div class="cf-perk"><i class="bi bi-cup-hot"></i>Freshly made</div>
              <div class="cf-perk"><i class="bi bi-clock-history"></i>~15 min ready</div>
              <div class="cf-perk"><i class="bi bi-heart"></i>Made with love</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Mobile checkout bar -->
  <div class="cf-mobile-bar hide" id="mobileBar">
    <div>
      <small>Total</small>
      <strong id="mobileTotal">₺0.00</strong>
    </div>
    <button type="button" class="btn cf-btn-primary" id="mobileCheckout">Checkout <i class="bi bi-arrow-right"></i></button>
  </div>

  <!-- ============ FOOTER (shared with Homepage) ============ -->
  <footer id="contact" class="cf-footer">
    <div class="container">
      <div class="cf-newsletter">
        <div>
          <h3>Get sweet news first</h3>
          <p>New flavors, seasonal menus and members-only offers.</p>
        </div>
        <form class="cf-newsletter-form" id="newsletterForm">
          <input type="email" placeholder="Your email address" aria-label="Email address" required />
          <button class="btn cf-btn-primary" type="submit">Subscribe</button>
        </form>
      </div>

      <div class="row g-5 cf-footer-main">
        <div class="col-lg-4">
          <a class="cf-logo mb-3 d-inline-flex" href="index.html">
            <span class="cf-logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
            Cafe<span>Flow</span>
          </a>
          <p class="cf-footer-text">A boutique café for handcrafted coffee, pretty desserts and slow, happy moments.</p>
          <div class="cf-socials">
            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
            <a href="#" aria-label="Pinterest"><i class="bi bi-pinterest"></i></a>
            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <h5>Explore</h5>
          <ul class="cf-footer-links">
            <li><a href="index.html">Home</a></li>
            <li><a href="products.html">Menu</a></li>
            <li><a href="index.html#about">About</a></li>
            <li><a href="index.html#order">Order</a></li>
          </ul>
        </div>

        <div class="col-6 col-lg-3">
          <h5>Visit us</h5>
          <ul class="cf-contact-list">
            <li><i class="bi bi-geo-alt"></i> 24 Blossom Street, Rose District</li>
            <li><i class="bi bi-telephone"></i> <a href="tel:+15550142233">+1 (555) 014-2233</a></li>
            <li><i class="bi bi-envelope"></i> <a href="mailto:hello@cafeflow.com">hello@cafeflow.com</a></li>
          </ul>
        </div>

        <div class="col-lg-3">
          <h5>Opening hours</h5>
          <ul class="cf-hours">
            <li><span>Mon – Fri</span><span>07:30 – 21:00</span></li>
            <li><span>Saturday</span><span>08:30 – 22:00</span></li>
            <li><span>Sunday</span><span>09:00 – 20:00</span></li>
          </ul>
          <span class="cf-open-now" id="openStatus"><span class="cf-dot"></span> Open now</span>
        </div>
      </div>

      <div class="cf-footer-bottom">
        <span>© <span id="year"></span> CafeFlow. All rights reserved.</span>
        <span>Made with <i class="bi bi-heart-fill"></i> and good coffee.</span>
      </div>
    </div>
  </footer>

  <!-- ============ CUSTOMIZE / EDIT MODAL (same design as Products Page) ============ -->
  <div class="modal fade cf-modal" id="customizeModal" tabindex="-1" aria-labelledby="customizeTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="row g-0">
          <div class="col-md-5">
            <div class="cf-modal-img" id="customizeImage"></div>
          </div>
          <div class="col-md-7">
            <button type="button" class="cf-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            <form class="cf-modal-body" id="customizeForm">
              <span class="cf-cat-label" id="customizeCategory">Hot Coffee</span>
              <h2 class="cf-modal-title" id="customizeTitle">Vanilla Latte</h2>
              <p class="cf-modal-desc" id="customizeDesc"></p>
              <div id="customizeOptions"></div>

              <div class="cf-modal-foot">
                <div class="cf-stepper" aria-label="Quantity">
                  <button type="button" id="modalQtyDec" aria-label="Decrease quantity"><i class="bi bi-dash"></i></button>
                  <span id="modalQty">1</span>
                  <button type="button" id="modalQtyInc" aria-label="Increase quantity"><i class="bi bi-plus"></i></button>
                </div>
                <div class="cf-modal-total">
                  <small>Estimated total</small>
                  <strong id="modalTotal">₺0.00</strong>
                </div>
                <button type="submit" class="btn cf-btn-primary cf-btn-lg" id="customizeSubmit">
                  <i class="bi bi-bag-plus"></i> Add to Cart
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ CONFIRM REMOVE MODAL ============ -->
  <div class="modal fade cf-dialog" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
      <div class="modal-content">
        <span class="cf-dialog-icon"><i class="bi bi-trash3"></i></span>
        <h3 id="confirmTitle">Remove this treat?</h3>
        <p id="confirmText">Setting the quantity to zero will remove it from your cart.</p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
          <button type="button" class="btn cf-btn-outline" data-bs-dismiss="modal">Keep it</button>
          <button type="button" class="btn cf-btn-primary" id="confirmYes">Yes, remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ CHECKOUT PLACEHOLDER MODAL ============ -->
  <div class="modal fade cf-dialog" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
      <div class="modal-content">
        <span class="cf-dialog-icon"><i class="bi bi-bag-check"></i></span>
        <h3 id="checkoutTitle">Your order details are ready</h3>
        <p>Here's what we'll take to the checkout step.</p>
        <div class="cf-dialog-recap" id="checkoutRecap"></div>
        <div class="cf-dev-note">
          <i class="bi bi-info-circle"></i>
          <span>The checkout step is not implemented yet. No order has been placed and no payment has been taken.</span>
        </div>
        <button type="button" class="btn cf-btn-primary w-100" data-bs-dismiss="modal">Got it</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="cf-toast" id="cfToast" role="status" aria-live="polite">
    <i class="bi bi-check-circle-fill" id="cfToastIcon"></i> <span id="cfToastText">Updated</span>
    <button type="button" class="cf-toast-action" id="cfToastAction">Undo</button>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
/* =========================================================
   CafeFlow — Cart Page
   Sections:
   1. Catalog data (identical to the Products Page)
   2. Cart-page config (fees, promo codes, table registry)
   3. Storage helpers + shared Cart module (same contract as Products Page)
   4. UI helpers
   5. Cart items rendering & actions
   6. Customize / edit modal
   7. Order type & details form
   8. Promo code
   9. Totals & summary
   10. Checkout
   11. Page bootstrap
   ========================================================= */
(() => {
  "use strict";

  /* ---------- 1. CATALOG DATA ----------
     Copied verbatim from products.html so IDs, prices and options match.
     In the ASP.NET Core MVC build this block (and the Cart module below)
     should move into one shared script, e.g. wwwroot/js/cafeflow-core.js. */
  const IMG = (id, w = 700) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&q=80`;

  const CATEGORIES = [
    { id: "all",       label: "All Products",     icon: "bi-grid" },
    { id: "hot",       label: "Hot Coffees",      icon: "bi-cup-hot" },
    { id: "iced",      label: "Iced Coffees",     icon: "bi-cup-straw" },
    { id: "signature", label: "Signature Drinks", icon: "bi-stars" },
    { id: "cakes",     label: "Cakes & Desserts", icon: "bi-cake2" },
    { id: "bakery",    label: "Bakery",           icon: "bi-basket" },
    { id: "snacks",    label: "Snacks",           icon: "bi-egg-fried" },
  ];

  const BADGES = {
    "Best Seller":   "cf-tag-best",
    "New":           "cf-tag-new",
    "Popular":       "cf-tag-popular",
    "Chef's Choice": "cf-tag-chef",
  };

  // Image fallback icon per category
  const FALLBACK_ICON = {
    hot: "bi-cup-hot", iced: "bi-cup-straw", signature: "bi-cup-straw",
    cakes: "bi-cake2", bakery: "bi-basket", snacks: "bi-egg-fried",
    coffee: "bi-cup-hot", cake: "bi-cake2",
  };

  /**
   * Central product catalogue. `popularity` drives "Most Popular" sorting,
   * `customizable` opens the options modal before adding to cart.
   */
  const PRODUCTS = [
    { id: 1,  name: "Classic Cappuccino",     category: "hot",       price: 145, image: IMG("1572442388796-11668a67e53d"), description: "Rich double espresso under a deep layer of velvety milk foam.", badge: null,            vegetarian: true,  popularity: 88, customizable: true },
    { id: 2,  name: "Vanilla Latte",          category: "hot",       price: 160, image: IMG("1509042239860-f550ce710b93"), description: "Smooth espresso and steamed milk with Madagascar vanilla.",       badge: "Best Seller",   vegetarian: true,  popularity: 95, customizable: true },
    { id: 3,  name: "Caramel Macchiato",      category: "hot",       price: 170, image: IMG("1485808191679-5f86510681a2"), description: "Vanilla milk marked with espresso and a buttery caramel drizzle.", badge: "Popular",      vegetarian: true,  popularity: 90, customizable: true },
    { id: 4,  name: "Iced Spanish Latte",     category: "iced",      price: 175, image: IMG("1461023058943-07fcbe16d735"), description: "Espresso over ice with creamy condensed milk sweetness.",           badge: "Best Seller",  vegetarian: true,  popularity: 96, customizable: true },
    { id: 5,  name: "Iced Mocha",             category: "iced",      price: 180, image: IMG("1517701604599-bb29b565090c"), description: "Double espresso, Belgian chocolate and cold milk over ice.",       badge: null,            vegetarian: true,  popularity: 82, customizable: true },
    { id: 6,  name: "Cold Brew",              category: "iced",      price: 155, image: IMG("1534778101976-62847782c213"), description: "Slow-steeped for 18 hours. Smooth, bold and naturally sweet.",     badge: null,            vegetarian: true,  popularity: 74, customizable: false },
