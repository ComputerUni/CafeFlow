@using CafeFlow.DTO.Order
@using CafeFlow.Entity.Enums
@model OrderConfirmationDto

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Siparişiniz Alındı";
}

<section class="cf-confirmation-section">
    <div class="container">
        <div class="cf-confirm-card">

            <!-- Başlık -->
            <div class="cf-confirm-hero">
                <div class="cf-confirm-icon">
                    <i class="bi bi-check-lg"></i>
                </div>
                <h1>Siparişiniz Alındı!</h1>
                <p class="text-muted">Siparişiniz hazırlanmaya başlandı. Teşekkür ederiz 🎉</p>
                <div class="cf-order-code">
                    <span>Sipariş Kodu</span>
                    <strong>#@Model.OrderCode</strong>
                </div>
            </div>

            <!-- Sipariş Detayları -->
            <div class="cf-confirm-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="cf-confirm-block">
                            <h6><i class="bi bi-box-seam"></i> Sipariş Türü</h6>
                            <p>
                                @switch (Model.OrderType)
                                {
                                    case OrderType.Online:
                                        <span><i class="bi bi-scooter"></i> Adrese Teslimat</span>
                                        break;
                                    case OrderType.TakeAway:
                                        <span><i class="bi bi-bag"></i> Gel-Al</span>
                                        break;
                                    case OrderType.Table:
                                        <span><i class="bi bi-cup-hot"></i> Masa @Model.TableId</span>
                                        break;
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <small class="text-muted">@Model.Address</small>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="cf-confirm-block">
                            <h6><i class="bi bi-person"></i> Müşteri</h6>
                            <p>@Model.CustomerName</p>
                            <small class="text-muted">@Model.PhoneNumber</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="cf-confirm-block">
                            <h6><i class="bi bi-receipt"></i> Sipariş İçeriği</h6>
                            <ul class="cf-confirm-items">
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <li>
                                        <span>@item.ProductName <small class="text-muted">x@item.Quantity</small></span>
                                        <span>₺@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                    </li>
                                }
                            </ul>
                            <div class="cf-confirm-total">
                                <span>Toplam</span>
                                <strong>₺@Model.TotalAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Aksiyonlar -->
            <div class="cf-confirm-actions">
                <a href="/Menu/Index" class="btn cf-btn-outline">
                    <i class="bi bi-arrow-left"></i> Menüye Dön
                </a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="/Customer/Orders" class="btn cf-btn-primary">
                        Siparişlerim <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>

        </div>
    </div>
</section>