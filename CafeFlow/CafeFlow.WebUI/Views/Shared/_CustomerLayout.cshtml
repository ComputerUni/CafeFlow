<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_CustomerLayoutHead")
<body>
    @await Component.InvokeAsync("_CustomerLayoutNavbar")

    @RenderBody()  

    @await Component.InvokeAsync("_CustomerLayoutCartDrawer")


    <div class="cf-toast" id="cfToast" role="status" aria-live="polite">
        <i class="bi bi-check-circle-fill"></i> <span id="cfToastText">Added to cart</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            /* =========================================================
               CafeFlow — Homepage Interactions
               ========================================================= */
            document.addEventListener("DOMContentLoaded", () => {
                /* ---------- Navbar: shrink on scroll ---------- */
                const nav = document.getElementById("mainNav");
                const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 30);
                onScroll();
                window.addEventListener("scroll", onScroll, { passive: true });

                /* ---------- Close mobile menu after clicking a link ---------- */
                const navCollapse = document.getElementById("navLinks");
                document.querySelectorAll("#navLinks .nav-link").forEach((link) => {
                    link.addEventListener("click", () => {
                        if (navCollapse.classList.contains("show")) {
                            bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
                        }
                    });
                });

                /* ---------- Image fallback (if a placeholder image fails to load) ---------- */
                const fallbackIcons = {
                    coffee: "bi-cup-hot",
                    drink: "bi-cup-straw",
                    cake: "bi-cake2",
                    pastry: "bi-basket",
                    cafe: "bi-shop",
                };
                document.querySelectorAll("img[data-fallback]").forEach((img) => {
                    const swap = () => {
                        const div = document.createElement("div");
                        div.className = "cf-img-fallback";
                        div.setAttribute("role", "img");
                        div.setAttribute("aria-label", img.alt);
                        div.innerHTML = `<i class="bi ${fallbackIcons[img.dataset.fallback] || "bi-heart"}"></i>`;
                        img.replaceWith(div);
                    };
                    if (img.complete && img.naturalWidth === 0) swap();
                    else img.addEventListener("error", swap, { once: true });
                });

                /* ---------- Reveal on scroll ---------- */
                const revealEls = document.querySelectorAll(".reveal");
                if ("IntersectionObserver" in window) {
                    const io = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("visible");
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
                    );
                    revealEls.forEach((el, i) => {
                        el.style.transitionDelay = `${(i % 4) * 80}ms`;
                        io.observe(el);
                    });
                } else {
                    revealEls.forEach((el) => el.classList.add("visible"));
                }

                /* ---------- Product filter ---------- */
                const filterBtns = document.querySelectorAll(".cf-filter button");
                const productCols = document.querySelectorAll("#productGrid [data-type]");
                filterBtns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        filterBtns.forEach((b) => b.classList.remove("active"));
                        btn.classList.add("active");
                        const type = btn.dataset.filter;
                        productCols.forEach((col) => {
                            const show = type === "all" || col.dataset.type === type;
                            col.classList.toggle("cf-hidden", !show);
                            if (show) col.classList.add("visible");
                        });
                    });
                });

                /* ---------- Favorite toggle ---------- */
                document.querySelectorAll(".cf-fav").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        btn.classList.toggle("liked");
                        btn.setAttribute("aria-pressed", btn.classList.contains("liked"));
                    });
                });

                /* ---------- Cart (static, in-memory) ---------- */
                const cart = new Map(); // name -> { price, qty }
                const cartCount = document.getElementById("cartCount");
                const cartItems = document.getElementById("cartItems");
                const cartEmpty = document.getElementById("cartEmpty");
                const cartFooter = document.getElementById("cartFooter");
                const cartTotal = document.getElementById("cartTotal");
                const money = (n) => `$${n.toFixed(2)}`;

                const renderCart = () => {
                    let count = 0;
                    let total = 0;
                    cartItems.innerHTML = "";

                    cart.forEach((item, name) => {
                        count += item.qty;
                        total += item.qty * item.price;
                        const li = document.createElement("li");
                        li.className = "cf-cart-item";
                        li.innerHTML = `
                                                        <div>
                                                          <strong>${name}</strong>
                                                          <small>${money(item.price)} each</small>
                                                        </div>
                                                        <div class="cf-qty">
                                                          <button type="button" data-action="dec" aria-label="Decrease ${name}">−</button>
                                                          <span>${item.qty}</span>
                                                          <button type="button" data-action="inc" aria-label="Increase ${name}">+</button>
                                                        </div>`;
                        li.querySelector('[data-action="dec"]').addEventListener("click", () => updateQty(name, -1));
                        li.querySelector('[data-action="inc"]').addEventListener("click", () => updateQty(name, 1));
                        cartItems.appendChild(li);
                    });

                    cartCount.textContent = count;
                    cartTotal.textContent = money(total);
                    const empty = cart.size === 0;
                    cartEmpty.classList.toggle("d-none", !empty);
                    cartFooter.classList.toggle("d-none", empty);
                };

                const updateQty = (name, delta) => {
                    const item = cart.get(name);
                    if (!item) return;
                    item.qty += delta;
                    if (item.qty <= 0) cart.delete(name);
                    renderCart();
                };

                const toast = document.getElementById("cfToast");
                const toastText = document.getElementById("cfToastText");
                let toastTimer;
                const showToast = (msg) => {
                    toastText.textContent = msg;
                    toast.classList.add("show");
                    clearTimeout(toastTimer);
                    toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
                };

                document.querySelectorAll(".cf-add-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const name = btn.dataset.name;
                        const price = parseFloat(btn.dataset.price);
                        const existing = cart.get(name);
                        if (existing) existing.qty += 1;
                        else cart.set(name, { price, qty: 1 });
                        renderCart();

                        cartCount.classList.add("bump");
                        setTimeout(() => cartCount.classList.remove("bump"), 300);

                        const original = btn.innerHTML;
                        btn.classList.add("added");
                        btn.innerHTML = '<i class="bi bi-check-lg"></i> Added';
                        setTimeout(() => {
                            btn.classList.remove("added");
                            btn.innerHTML = original;
                        }, 1200);

                        showToast(`${name} added to your cart`);
                    });
                });

                /* ---------- Newsletter ---------- */
                document.getElementById("newsletterForm").addEventListener("submit", (e) => {
                    e.preventDefault();
                    e.target.reset();
                    showToast("Thanks! You're on the sweet list.");
                });

                /* ---------- Open / closed status ---------- */
                const status = document.getElementById("openStatus");
                const now = new Date();
                const day = now.getDay(); // 0 = Sun
                const mins = now.getHours() * 60 + now.getMinutes();
                const hours = {
                    0: [9 * 60, 20 * 60],
                    6: [8 * 60 + 30, 22 * 60],
                };
                const [open, close] = hours[day] || [7 * 60 + 30, 21 * 60];
                if (mins < open || mins >= close) {
                    status.classList.add("closed");
                    status.innerHTML = '<span class="cf-dot"></span> Closed now';
                }

                /* ---------- Footer year ---------- */
                document.getElementById("year").textContent = now.getFullYear();
            });

    </script>
</body>
</html>