<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_CustomerLayoutHead")
<body>
    @await Component.InvokeAsync("_CustomerLayoutNavbar")

    @RenderBody()  

    @await Component.InvokeAsync("_CustomerLayoutCartDrawer")


    <div class="cf-toast" id="cfToast" role="status" aria-live="polite">
        <i class="bi bi-check-circle-fill"></i> <span id="cfToastText">Added to cart</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            /* =========================================================
               CafeFlow — Homepage Interactions
               ========================================================= */
            document.addEventListener("DOMContentLoaded", () => {
                /* ---------- Navbar: shrink on scroll ---------- */
                const nav = document.getElementById("mainNav");
                const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 30);
                onScroll();
                window.addEventListener("scroll", onScroll, { passive: true });

                /* ---------- Close mobile menu after clicking a link ---------- */
                const navCollapse = document.getElementById("navLinks");
                document.querySelectorAll("#navLinks .nav-link").forEach((link) => {
                    link.addEventListener("click", () => {
                        if (navCollapse.classList.contains("show")) {
                            bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
                        }
                    });
                });

                /* ---------- Image fallback (if a placeholder image fails to load) ---------- */
                const fallbackIcons = {
                    coffee: "bi-cup-hot",
                    drink: "bi-cup-straw",
                    cake: "bi-cake2",
                    pastry: "bi-basket",
                    cafe: "bi-shop",
                };
                document.querySelectorAll("img[data-fallback]").forEach((img) => {
                    const swap = () => {
                        const div = document.createElement("div");
                        div.className = "cf-img-fallback";
                        div.setAttribute("role", "img");
                        div.setAttribute("aria-label", img.alt);
                        div.innerHTML = `<i class="bi ${fallbackIcons[img.dataset.fallback] || "bi-heart"}"></i>`;
                        img.replaceWith(div);
                    };
                    if (img.complete && img.naturalWidth === 0) swap();
                    else img.addEventListener("error", swap, { once: true });
                });

                /* ---------- Reveal on scroll ---------- */
                const revealEls = document.querySelectorAll(".reveal");
                if ("IntersectionObserver" in window) {
                    const io = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("visible");
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
                    );
                    revealEls.forEach((el, i) => {
                        el.style.transitionDelay = `${(i % 4) * 80}ms`;
                        io.observe(el);
                    });
                } else {
                    revealEls.forEach((el) => el.classList.add("visible"));
                }

                /* ---------- Product filter ---------- */
                const filterBtns = document.querySelectorAll(".cf-filter button");
                const productCols = document.querySelectorAll("#productGrid [data-type]");
                filterBtns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        filterBtns.forEach((b) => b.classList.remove("active"));
                        btn.classList.add("active");
                        const type = btn.dataset.filter;
                        productCols.forEach((col) => {
                            const show = type === "all" || col.dataset.type === type;
                            col.classList.toggle("cf-hidden", !show);
                            if (show) col.classList.add("visible");
                        });
                    });
                });

                /* ---------- Favorite toggle ---------- */
                document.querySelectorAll(".cf-fav").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        btn.classList.toggle("liked");
                        btn.setAttribute("aria-pressed", btn.classList.contains("liked"));
                    });
                });

                /* ---------- Cart (localStorage tabanlı) ---------- */
                const CART_KEY = "cafeflow_cart";
                const cartCount = document.getElementById("cartCount");
                const cartItems = document.getElementById("cartItems");
                const cartEmpty = document.getElementById("cartEmpty");
                const cartFooter = document.getElementById("cartFooter");
                const cartTotal = document.getElementById("cartTotal");

                function _cartLoad() {
                    try { return JSON.parse(localStorage.getItem(CART_KEY) || "[]"); }
                    catch { return []; }
                }
                function _cartSave(items) {
                    try { localStorage.setItem(CART_KEY, JSON.stringify(items)); } catch { }
                }

                function renderCart() {
                    const items = _cartLoad();
                    const count = items.reduce((s, i) => s + (i.quantity || 0), 0);
                    const total = items.reduce((s, i) => s + i.unitPrice * i.quantity, 0);

                    if (cartCount) cartCount.textContent = count;
                    if (cartTotal) cartTotal.textContent = `₺${total.toFixed(2)}`;
                    if (cartEmpty) cartEmpty.classList.toggle("d-none", items.length > 0);
                    if (cartFooter) cartFooter.classList.toggle("d-none", items.length === 0);

                    if (cartItems) {
                        cartItems.innerHTML = items.map(item => `
                        <li class="cf-cart-line" data-line="${item.lineId}">
                            <img src="${item.image}" alt="${item.name}" style="width:48px;height:48px;object-fit:cover;border-radius:8px" />
                            <div style="flex:1">
                                <strong>${item.name}</strong>
                                <small>₺${item.unitPrice.toFixed(2)} each</small>
                            </div>
                            <div class="cf-stepper">
                                <button type="button" data-action="dec" data-line="${item.lineId}"><i class="bi bi-dash"></i></button>
                                <span>${item.quantity}</span>
                                <button type="button" data-action="inc" data-line="${item.lineId}"><i class="bi bi-plus"></i></button>
                            </div>
                            <button type="button" data-action="remove" data-line="${item.lineId}"><i class="bi bi-trash3"></i></button>
                        </li>`).join("");
                    }
                }

                if (cartItems) {
                    cartItems.addEventListener("click", (e) => {
                        const btn = e.target.closest("[data-action]");
                        if (!btn) return;
                        const lineId = btn.dataset.line;
                        const items = _cartLoad();
                        const item = items.find(i => i.lineId === lineId);
                        if (!item) return;
                        if (btn.dataset.action === "inc") item.quantity++;
                        else if (btn.dataset.action === "dec") {
                            item.quantity--;
                            if (item.quantity <= 0) { _cartSave(items.filter(i => i.lineId !== lineId)); renderCart(); return; }
                        } else if (btn.dataset.action === "remove") {
                            _cartSave(items.filter(i => i.lineId !== lineId)); renderCart(); return;
                        }
                        _cartSave(items);
                        renderCart();
                    });
                }

                window.addToCart = (productId, name, price, imageUrl = "") => {
                    const items = _cartLoad();
                    const lineId = String(productId);
                    const existing = items.find(i => i.lineId === lineId);
                    if (existing) existing.quantity++;
                    else items.push({ lineId, productId, name, unitPrice: price, quantity: 1, image: imageUrl, options: null });
                    _cartSave(items);
                    renderCart();
                    cartCount.classList.add("bump");
                    setTimeout(() => cartCount.classList.remove("bump"), 300);
                    showToast(`${name} sepete eklendi`);
                };

                window.addEventListener("storage", (e) => {
                    if (e.key === CART_KEY) renderCart();
                });

                renderCart();

                const updateQty = (name, delta) => {
                    const item = cart.get(name);
                    if (!item) return;
                    item.qty += delta;
                    if (item.qty <= 0) cart.delete(name);
                    renderCart();
                };

                const toast = document.getElementById("cfToast");
                const toastText = document.getElementById("cfToastText");
                let toastTimer;
                const showToast = (msg) => {
                    toastText.textContent = msg;
                    toast.classList.add("show");
                    clearTimeout(toastTimer);
                    toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
                };

                document.querySelectorAll(".cf-add-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const name = btn.dataset.name;
                        const price = parseFloat(btn.dataset.price);
                        const existing = cart.get(name);
                        if (existing) existing.qty += 1;
                        else cart.set(name, { price, qty: 1 });
                        renderCart();

                        cartCount.classList.add("bump");
                        setTimeout(() => cartCount.classList.remove("bump"), 300);

                        const original = btn.innerHTML;
                        btn.classList.add("added");
                        btn.innerHTML = '<i class="bi bi-check-lg"></i> Added';
                        setTimeout(() => {
                            btn.classList.remove("added");
                            btn.innerHTML = original;
                        }, 1200);

                        showToast(`${name} added to your cart`);
                    });
                });

                /* ---------- Newsletter ---------- */
                document.getElementById("newsletterForm").addEventListener("submit", (e) => {
                    e.preventDefault();
                    e.target.reset();
                    showToast("Thanks! You're on the sweet list.");
                });

                /* ---------- Open / closed status ---------- */
                const status = document.getElementById("openStatus");
                const now = new Date();
                const day = now.getDay(); // 0 = Sun
                const mins = now.getHours() * 60 + now.getMinutes();
                const hours = {
                    0: [9 * 60, 20 * 60],
                    6: [8 * 60 + 30, 22 * 60],
                };
                const [open, close] = hours[day] || [7 * 60 + 30, 21 * 60];
                if (mins < open || mins >= close) {
                    status.classList.add("closed");
                    status.innerHTML = '<span class="cf-dot"></span> Closed now';
                }

                /* ---------- Footer year ---------- */
                document.getElementById("year").textContent = now.getFullYear();
            });

    </script>
</body>
</html>