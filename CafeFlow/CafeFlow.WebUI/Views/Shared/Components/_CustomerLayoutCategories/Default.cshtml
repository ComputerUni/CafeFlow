@using CafeFlow.DTO.Category
@model List<CategoryListDto>

<section id="menu" class="cf-section">
    <div class="container">
        <div class="cf-section-head reveal">
            <span class="cf-eyebrow">Menüyü Keşfedin</span>
            <h2 class="cf-section-title">Her ana tat katacak lezzetler</h2>
            <p class="cf-section-sub">Günün ilk espressosundan öğleden sonra kaçamağınıza kadar favori lezzetlerimize göz atın.</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-lg-3 reveal">
                    <a href="/Menu/Index" class="cf-category-card">
                        <span class="cf-cat-icon" style="padding: 0; overflow: hidden; width: 72px; height: 72px; border-radius: 16px; border: 2px solid #fde8ee; display: inline-flex;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-cup-hot"></i>
                            }
                        </span>
                        <h3>@item.Name</h3>
                        <p>@item.Description</p>
                        <span class="cf-cat-link">@item.ProductCount çeşit <i class="bi bi-arrow-up-right"></i></span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>