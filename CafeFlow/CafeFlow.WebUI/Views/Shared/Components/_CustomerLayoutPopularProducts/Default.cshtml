@using CafeFlow.DTO.Product
@model List<ProductListDto>

<section id="products" class="cf-section cf-section-tint">
    <div class="container">
        <div class="cf-section-head d-md-flex justify-content-between align-items-end text-md-start reveal">
            <div>
                <span class="cf-eyebrow">En Çok Sevilenler</span>
                <h2 class="cf-section-title mb-md-0">Haftanın Popülerleri</h2>
            </div>
            <div class="cf-filter" role="tablist" aria-label="Ürün Filtreleri">
                <button class="active" data-filter="all">Tümü</button>
                <button data-filter="drinks">İçecekler</button>
                <button data-filter="sweets">Tatlılar</button>
                <button data-filter="snacks">Atıştırmalıklar</button>
            </div>
        </div>

        <div class="row g-4" id="productGrid">
            @foreach (var item in Model)
            {
                string catSlug = "drinks";
                string rawCat = item.CategoryName?.ToLower() ?? "";

                if (rawCat.Contains("tatlı") || rawCat.Contains("sweet") || rawCat.Contains("pasta") || rawCat.Contains("cake"))
                {
                    catSlug = "sweets";
                }
                else if (rawCat.Contains("atıştırma") || rawCat.Contains("snack") || rawCat.Contains("sandviç"))
                {
                    catSlug = "snacks";
                }
                else
                {
                    catSlug = "drinks";
                }

                <div class="col-sm-6 col-lg-4 reveal" data-type="@catSlug">
                    <article class="cf-product-card">
                        <div class="cf-product-img">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 loading="lazy"
                                 onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500'" />

                            <span class="cf-tag">Öne Çıkan</span>

                            <button class="cf-fav"
                                    data-id="@item.Id"
                                    aria-label="Favorilere ekle"
                                    type="button">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="cf-product-body">
                            <div class="cf-rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                @(item.AverageRating > 0 ? item.AverageRating.ToString("0.0") : "4.9")
                            </div>

                            <h3>@item.Name</h3>
                            <p>@item.Description</p>

                            <div class="cf-product-foot">
                                <span class="cf-price">@item.Price.ToString("C2")</span>

                                <button type="button"
                                        class="btn cf-add-btn"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-price="@item.Price"
                                        data-image="@item.ImageUrl">
                                    <i class="bi bi-plus-lg"></i> Ekle
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="text-center mt-5 reveal">
            <a href="#menu" class="btn cf-btn-outline cf-btn-lg">Tüm Menüyü İncele <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</section>