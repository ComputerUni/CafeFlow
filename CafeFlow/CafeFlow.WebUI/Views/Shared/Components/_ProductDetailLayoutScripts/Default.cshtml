            { id: 16, name: "Cinnamon Roll", category: "bakery", price: 115, image: IMG("1509365465985-25d11c17e812"), description: "Soft brioche swirl with cinnamon sugar and cream cheese glaze.", badge: "New", vegetarian: true, popularity: 72, customizable: false },
            { id: 17, name: "Avocado Toast", category: "snacks", price: 235, image: IMG("1541519227354-08fa5d50c44d"), description: "Sourdough, smashed avocado, cherry tomatoes and chili flakes.", badge: "Chef's Choice", vegetarian: true, popularity: 84, customizable: false },
            { id: 18, name: "Grilled Cheese Sandwich", category: "snacks", price: 210, image: IMG("1528735602780-2552fd46c7af"), description: "Cheddar and mozzarella melted on buttery toasted brioche.", badge: null, vegetarian: true, popularity: 70, customizable: false },
            { id: 19, name: "Turkey & Brie Panini", category: "snacks", price: 255, image: IMG("1528736235302-52922df5c122"), description: "Smoked turkey, creamy brie and fig jam, pressed until golden.", badge: null, vegetarian: false, popularity: 77, customizable: false },
            { id: 20, name: "Chicken Caesar Wrap", category: "snacks", price: 245, image: IMG("1626700051175-6818013e1d4f"), description: "Grilled chicken, crisp romaine, parmesan and house Caesar dressing.", badge: null, vegetarian: false, popularity: 73, customizable: false },
        ];

        /** Option groups for customizable drinks. `price` is added to the base price. */
        const CUSTOM_OPTIONS = [
            {
                key: "size", label: "Size", choices: [
                    { value: "Small", price: 0 },
                    { value: "Medium", price: 15 },
                    { value: "Large", price: 30 },
                ], default: "Medium"
            },
            {
                key: "milk", label: "Milk", choices: [
                    { value: "Regular", price: 0 },
                    { value: "Oat", price: 15 },
                    { value: "Almond", price: 15 },
                ], default: "Regular"
            },
            {
                key: "extraShot", label: "Extra Espresso Shot", choices: [
                    { value: "No", price: 0 },
                    { value: "Yes", price: 20 },
                ], default: "No"
            },
            {
                key: "syrup", label: "Additional Syrup", choices: [
                    { value: "None", price: 0 },
                    { value: "Vanilla", price: 10 },
                    { value: "Caramel", price: 10 },
                ], default: "None"
            },
        ];

        const findProduct = (id) => PRODUCTS.find((p) => p.id === id);

        /* ---------- 2. PAGE CONTENT DATA ----------
           Extra copy for the details page only. Prices and options always come from
           the catalog above; nothing here affects pricing. */

        // Display-only metadata for the existing option values
        const SIZE_VOLUMES = { Small: "250 ml", Medium: "350 ml", Large: "450 ml" };
        const MILK_LABELS = { Regular: "Regular Milk", Oat: "Oat Milk", Almond: "Almond Milk" };

        const PRODUCT_CONTENT = {
            1: { about: "Our cappuccino starts with a double shot of our house blend, pulled short and sweet, then crowned with silky, deep milk foam. Balanced, comforting and exactly what a slow morning needs.", ingredients: ["Espresso", "Milk", "Milk foam", "Cocoa dusting"], allergens: ["Milk"] },
            2: { about: "A gentle classic: smooth espresso and steamed milk sweetened with real Madagascar vanilla. Soft, creamy and endlessly cozy.", ingredients: ["Espresso", "Milk", "Vanilla syrup"], allergens: ["Milk"] },
            3: { about: "Vanilla-sweetened milk layered under a bold espresso shot, finished with a lattice of buttery caramel sauce. Stir it or sip it in layers.", ingredients: ["Espresso", "Milk", "Vanilla syrup", "Caramel sauce"], allergens: ["Milk"] },
            4: { about: "Espresso poured over ice and creamy milk, sweetened with a ribbon of condensed milk for that famously smooth, caramel-like finish.", ingredients: ["Espresso", "Milk", "Condensed milk", "Ice"], allergens: ["Milk"] },
            5: { about: "Double espresso shaken with Belgian chocolate sauce and cold milk, served over ice for a rich, refreshing chocolate-coffee moment.", ingredients: ["Espresso", "Milk", "Belgian chocolate sauce", "Ice"], allergens: ["Milk", "Soy"] },
            6: { about: "Coarsely ground beans steeped in cold water for 18 hours, then filtered for a naturally sweet, low-acidity coffee with chocolate notes.", ingredients: ["Cold-brewed coffee", "Filtered water", "Ice"], allergens: [] },
            7: { short: "A dreamy blend of espresso, creamy milk and sweet strawberry notes, topped with our signature cloud foam.", about: "Our most-loved signature: house-made strawberry milk, a shot of espresso and a fluffy pink cloud foam on top. It tastes like strawberries and cream with a gentle coffee hug.", ingredients: ["Espresso", "Milk", "Strawberry purée", "Cloud foam", "Natural flavoring"], allergens: ["Milk"] },
            8: { about: "Ceremonial-grade matcha whisked smooth and paired with a delicate rose syrup and oat milk. Floral, earthy and beautifully calming.", ingredients: ["Matcha", "Oat milk", "Rose syrup", "Ice (on request)"], allergens: ["Oats (gluten)"] },
            9: { about: "Raspberries, strawberries and vanilla cream blended until frosty, then finished with whipped cream and a sprinkle of berry dust.", ingredients: ["Raspberry", "Strawberry", "Vanilla cream", "Milk", "Whipped cream", "Ice"], allergens: ["Milk"] },
            10: { about: "A tender, rose-tinted vanilla sponge layered with whipped cream cheese frosting and finished with a light dusting of crumbs. Baked fresh in our kitchen.", ingredients: ["Flour", "Eggs", "Butter", "Sugar", "Cream cheese", "Vanilla", "Natural coloring"], allergens: ["Gluten", "Eggs", "Milk"] },
            11: { about: "Creamy baked cheesecake on a crunchy Biscoff biscuit base, topped with caramelized biscuit spread and a drizzle of caramel.", ingredients: ["Cream cheese", "Biscoff biscuits", "Butter", "Eggs", "Sugar", "Caramel"], allergens: ["Gluten", "Eggs", "Milk", "Soy"] },
            12: { about: "Feather-light chiffon sponge layered with fresh strawberries and whipped mascarpone cream. Fresh, airy and not too sweet.", ingredients: ["Flour", "Eggs", "Sugar", "Strawberries", "Mascarpone", "Cream"], allergens: ["Gluten", "Eggs", "Milk"] },
            13: { about: "Four delicate almond-meringue shells sandwiching a tangy raspberry white-chocolate ganache. A pretty little box to share (or not).", ingredients: ["Almond flour", "Egg whites", "Sugar", "Raspberry", "White chocolate", "Cream"], allergens: ["Nuts (almond)", "Eggs", "Milk", "Soy"] },
            14: { about: "Laminated with French butter and baked every morning until deeply golden. Crisp, flaky layers outside and a soft, honeycomb crumb inside.", ingredients: ["Flour", "Butter", "Milk", "Yeast", "Sugar", "Salt", "Egg wash"], allergens: ["Gluten", "Milk", "Eggs"] },
            15: { about: "Our butter croissant, filled with almond frangipane, twice-baked and topped with toasted almond flakes and powdered sugar.", ingredients: ["Croissant dough", "Almond frangipane", "Almond flakes", "Powdered sugar"], allergens: ["Gluten", "Milk", "Eggs", "Nuts (almond)"] },
            16: { about: "A soft brioche swirl filled with cinnamon sugar and finished with a generous cream cheese glaze while still warm.", ingredients: ["Brioche dough", "Butter", "Cinnamon", "Brown sugar", "Cream cheese glaze"], allergens: ["Gluten", "Milk", "Eggs"] },
            17: { about: "Toasted sourdough topped with smashed avocado, lemon, cherry tomatoes, chili flakes and a drizzle of olive oil.", ingredients: ["Sourdough bread", "Avocado", "Cherry tomatoes", "Lemon", "Chili flakes", "Olive oil"], allergens: ["Gluten"] },
            18: { about: "Aged cheddar and mozzarella melted between slices of buttery toasted brioche. Simple, golden and very comforting.", ingredients: ["Brioche bread", "Cheddar", "Mozzarella", "Butter"], allergens: ["Gluten", "Milk", "Eggs"] },
            19: { about: "Smoked turkey breast, creamy brie and a spoon of fig jam, pressed in ciabatta until crisp and melty.", ingredients: ["Ciabatta", "Smoked turkey", "Brie", "Fig jam", "Arugula"], allergens: ["Gluten", "Milk"] },
            20: { about: "Grilled chicken, crisp romaine, shaved parmesan and our house Caesar dressing, wrapped in a soft tortilla.", ingredients: ["Tortilla", "Grilled chicken", "Romaine", "Parmesan", "Caesar dressing"], allergens: ["Gluten", "Milk", "Eggs", "Fish (anchovy)"] },
        };

        /** Sample reviews (static demo content). */
        const SAMPLE_REVIEWS = [
            { name: "Elif K.", rating: 5, date: "September 28, 2026", text: "Exactly as pretty as it looks, and it tastes even better. Already planning my next visit." },
            { name: "Mert A.", rating: 5, date: "September 14, 2026", text: "Perfect balance, not too sweet. Ordered through the table QR and it arrived in minutes." },
            { name: "Zeynep D.", rating: 4, date: "August 30, 2026", text: "Lovely and very fresh. I'd happily order it again with oat milk next time." },
        ];

        /* ---------- 3. STORAGE, CART, FAVORITES ---------- */
        const STORAGE_KEYS = { cart: "cafeflow_cart", favorites: "cafeflow_favorites" };

        const storage = {
            read(key, fallback) {
                try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; }
                catch { return fallback; }
            },
            write(key, value) {
                try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage unavailable */ }
            },
        };

        /** Unit price = base price + option extras (same rule as Products & Cart pages). */
        function priceWithOptions(product, options) {
            if (!options) return product.price;
            return product.price + CUSTOM_OPTIONS.reduce((sum, group) => {
                const choice = group.choices.find((c) => c.value === options[group.key]);
                return sum + (choice ? choice.price : 0);
            }, 0);
        }

        /**
         * Shared cart contract:
         * { lineId, productId, name, image, unitPrice, quantity, options }
         * lineId encodes the full configuration, so differently customized drinks
         * stay separate lines and identical ones merge.
         */
        const Cart = {
            items: storage.read(STORAGE_KEYS.cart, []),
            save() {
                storage.write(STORAGE_KEYS.cart, this.items);
                document.dispatchEvent(new CustomEvent("cart:changed"));
            },
            buildLineId(productId, options) {
                if (!options) return String(productId);
                return [productId, ...Object.entries(options).map(([k, v]) => `${k}:${v}`)].join("|");
            },
            add(product, { options = null, quantity = 1 } = {}) {
                const lineId = this.buildLineId(product.id, options);
                const existing = this.items.find((l) => l.lineId === lineId);
                if (existing) existing.quantity += quantity;
                else this.items.push({ lineId, productId: product.id, name: product.name, image: product.image, unitPrice: priceWithOptions(product, options), quantity, options });
                this.save();
                return lineId;
            },
            setQuantity(lineId, quantity) {
                const line = this.items.find((l) => l.lineId === lineId);
                if (!line) return;
                if (quantity <= 0) this.items = this.items.filter((l) => l.lineId !== lineId);
                else line.quantity = quantity;
                this.save();
            },
            remove(lineId) { this.items = this.items.filter((l) => l.lineId !== lineId); this.save(); },
            count() { return this.items.reduce((s, l) => s + l.quantity, 0); },
            subtotal() { return this.items.reduce((s, l) => s + l.unitPrice * l.quantity, 0); },
        };

        const Favorites = {
            ids: new Set(storage.read(STORAGE_KEYS.favorites, [])),
            toggle(id) {
                this.ids.has(id) ? this.ids.delete(id) : this.ids.add(id);
                storage.write(STORAGE_KEYS.favorites, [...this.ids]);
                return this.ids.has(id);
            },
            has(id) { return this.ids.has(id); },
            reload() { this.ids = new Set(storage.read(STORAGE_KEYS.favorites, [])); },
        };

        /* ---------- 4. UI HELPERS ---------- */
        const $ = (sel, root = document) => root.querySelector(sel);
        const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
        const formatMoney = (n) => `₺${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const detailUrl = (id) => `product-detail.html?id=${id}`;
        const category = (id) => CATEGORIES.find((c) => c.id === id) || { label: "", icon: "bi-heart" };

        function attachImageFallback(img) {
            const swap = () => {
                const div = document.createElement("div");
                div.className = "cf-img-fallback";
                div.setAttribute("role", "img");
                div.setAttribute("aria-label", img.alt);
                div.innerHTML = `<i class="bi ${FALLBACK_ICON[img.dataset.fallback] || "bi-heart"}"></i>`;
                img.replaceWith(div);
            };
            if (img.complete && img.naturalWidth === 0 && img.getAttribute("src")) swap();
            else img.addEventListener("error", swap, { once: true });
        }
        const applyFallbacks = (root = document) => $$("img[data-fallback]", root).forEach(attachImageFallback);

        const toastEl = $("#cfToast");
        let toastTimer;
        function showToast(message) {
            $("#cfToastText").textContent = message;
            toastEl.classList.add("show");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toastEl.classList.remove("show"), 2600);
        }

        function starsHtml(rating) {
            let html = "";
            for (let i = 1; i <= 5; i++) {
                html += `<i class="bi ${rating >= i ? "bi-star-fill" : rating >= i - 0.5 ? "bi-star-half" : "bi-star"}"></i>`;
            }
            return html;
        }

        /** Demo rating derived from the catalog's popularity score (clearly labeled as demo in the UI). */
        const demoRating = (p) => Math.min(5, Math.round((4.3 + p.popularity / 150) * 10) / 10);
        const demoReviewCount = (p) => p.popularity * 3 + (p.id % 7) * 4;

        /* ---------- 5. PRODUCT RENDERING ---------- */
        const productId = Number(new URLSearchParams(location.search).get("id"));
        const product = findProduct(productId);
        const content = product ? (PRODUCT_CONTENT[product.id] || {}) : {};

        const state = {
            quantity: 1,
            options: null, // { size, milk, extraShot, syrup } for customizable products
        };

        function renderNotFound() {
            document.title = "Treat not found — CafeFlow";
            $("#notFound").classList.remove("d-none");
            $("#breadcrumb").insertAdjacentHTML("beforeend", `<i class="bi bi-chevron-right"></i><span aria-current="page">Not found</span>`);
            $("#mobileBar").remove();
        }

        function renderHeader() {
            const cat = category(product.category);
            document.title = `${product.name} — CafeFlow`;
            const meta = document.querySelector('meta[name="description"]');
            if (meta) meta.content = product.description;
            $("#breadcrumb").insertAdjacentHTML("beforeend", `
                          <i class="bi bi-chevron-right"></i>
                          <a href="products.html?category=${product.category}">${cat.label}</a>
                          <i class="bi bi-chevron-right"></i>
                          <span aria-current="page">${product.name}</span>`);
        }

        /**
         * Gallery: the catalog holds one photo per product, so we show it plus
         * closer crops of the SAME photo (never unrelated pictures).
         */
        function galleryImages() {
            const base = product.image.split("?")[0];
            const views = [
                { label: "Full view", params: "auto=format&fit=crop&w=1100&q=85" },
                { label: "Close-up", params: "auto=format&fit=crop&crop=focalpoint&fp-x=0.5&fp-y=0.45&fp-z=1.6&w=1100&q=85" },
                { label: "Top detail", params: "auto=format&fit=crop&crop=focalpoint&fp-x=0.5&fp-y=0.3&fp-z=2.2&w=1100&q=85" },
            ];
            return views.map((v) => ({ label: v.label, src: `${base}?${v.params}`, thumb: `${base}?${v.params.replace("w=1100", "w=220")}` }));
        }

        function renderGallery() {
            const images = galleryImages();
            const main = $("#galleryMain");
            main.insertAdjacentHTML("afterbegin", `<img src="${images[0].src}" alt="${product.name}" id="mainImage" data-fallback="${product.category}" />`);

            $("#galleryThumbs").innerHTML = images.map((img, i) => `
                          <button type="button" class="cf-thumb${i === 0 ? " active" : ""}" data-index="${i}" aria-label="${img.label} of ${product.name}" aria-pressed="${i === 0}">
                            <img src="${img.thumb}" alt="" data-fallback="${product.category}" loading="lazy" />
                          </button>`).join("");

            if (product.badge) {
                const badge = $("#productBadge");
                badge.textContent = product.badge;
                badge.classList.add(BADGES[product.badge]);
                badge.classList.remove("d-none");
            }

            // Thumbnail switching with a soft cross-fade
            $("#galleryThumbs").addEventListener("click", (e) => {
                const btn = e.target.closest(".cf-thumb");
                if (!btn) return;
                const img = $("#mainImage");
                const next = images[Number(btn.dataset.index)];
                $$(".cf-thumb").forEach((t) => { t.classList.toggle("active", t === btn); t.setAttribute("aria-pressed", t === btn); });
                $("#galleryCaption").innerHTML = `<i class="bi bi-image"></i> ${next.label}`;
                if (!img) return;
                img.classList.add("is-fading");
                setTimeout(() => {
                    img.src = next.src;
                    img.onload = () => img.classList.remove("is-fading");
                    setTimeout(() => img.classList.remove("is-fading"), 600);
                }, 200);
            });

            // Subtle hover zoom that follows the cursor (pointer devices only)
            if (window.matchMedia("(hover: hover)").matches) {
                main.addEventListener("mousemove", (e) => {
                    if (e.target.closest(".cf-fav")) { main.classList.remove("is-zoomed"); return; }
                    const r = main.getBoundingClientRect();
                    main.style.setProperty("--zx", `${((e.clientX - r.left) / r.width) * 100}%`);
                    main.style.setProperty("--zy", `${((e.clientY - r.top) / r.height) * 100}%`);
                    main.classList.add("is-zoomed");
                });
                main.addEventListener("mouseleave", () => main.classList.remove("is-zoomed"));
            } else {
                $("#galleryCaption").innerHTML = `<i class="bi bi-image"></i> Full view`;
            }
            applyFallbacks(main);
            applyFallbacks($("#galleryThumbs"));
        }

        function renderFavorite() {
            const btn = $("#favBtn");
            const liked = Favorites.has(product.id);
            btn.classList.toggle("liked", liked);
            btn.setAttribute("aria-pressed", liked);
            btn.setAttribute("aria-label", `${liked ? "Remove from" : "Add to"} favorites`);
            btn.querySelector("i").className = `bi ${liked ? "bi-heart-fill" : "bi-heart"}`;
        }

        function renderInfo() {
            const cat = category(product.category);
            const rating = demoRating(product);
            $("#productCategory").innerHTML = `<i class="bi ${cat.icon}"></i> ${cat.label}`;
            $("#productName").textContent = product.name;
            $("#productShortDesc").textContent = content.short || product.description;
            $("#ratingStars").innerHTML = starsHtml(rating);
            $("#ratingValue").textContent = rating.toFixed(1);
            $("#reviewCountLabel").textContent = `(${demoReviewCount(product)} reviews)`;
            $("#basePrice").textContent = formatMoney(product.price);
            $("#priceLabel").textContent = product.customizable ? "Starting from" : "Price";
            $("#customNote").classList.toggle("d-none", !product.customizable);
        }

        function renderTabs() {
            const rating = demoRating(product);
            $("#descContent").innerHTML = `
                          <h3>About ${product.name}</h3>
                          <p>${content.about || product.description}</p>
                          ${product.customizable ? `<p class="mb-0">Make it yours with a choice of size, milk, an extra espresso shot or a touch of syrup. Your selections are saved with your order.</p>` : ""}`;

            const ingredients = content.ingredients || [];
            $("#ingredientList").innerHTML = ingredients.length
                ? ingredients.map((i) => `<li><i class="bi bi-dot"></i>${i}</li>`).join("")
                : `<li>Ingredient details coming soon</li>`;

            const allergens = content.allergens || [];
            $("#allergenList").innerHTML = allergens.length
                ? allergens.map((a) => `<div class="cf-allergen"><i class="bi bi-exclamation-triangle"></i>Contains ${a}</div>`).join("")
                : `<div class="cf-allergen none"><i class="bi bi-check2"></i>No major allergens in the recipe</div>`;

            $("#reviewScore").textContent = rating.toFixed(1);
            $("#reviewStars").innerHTML = starsHtml(rating);
            $("#reviewList").innerHTML = SAMPLE_REVIEWS.map((r) => `
                          <div class="col-md-4">
                            <figure class="cf-review">
                              <div class="cf-stars" aria-label="${r.rating} out of 5 stars">${starsHtml(r.rating)}</div>
                              <blockquote>“${r.text}”</blockquote>
                              <figcaption>
                                <span class="cf-avatar">${r.name.split(" ").map((n) => n[0]).join("")}</span>
                                <div><strong>${r.name}</strong><small class="cf-review-date">${r.date}</small></div>
                              </figcaption>
                            </figure>
                          </div>`).join("");
        }

        /* ---------- 6. CUSTOMIZATION & LIVE PRICING ---------- */
        const optionGroup = (key) => CUSTOM_OPTIONS.find((g) => g.key === key);
        const extraFor = (key, value) => (optionGroup(key).choices.find((c) => c.value === value) || { price: 0 }).price;
        const priceTag = (price, zeroLabel = "Included") => (price ? `+${formatMoney(price)}` : zeroLabel);

        function renderCustomization() {
            if (!product.customizable) return;
            $("#customSections").classList.remove("d-none");
            state.options = Object.fromEntries(CUSTOM_OPTIONS.map((g) => [g.key, g.default]));

            // Size cards
            $("#sizeOptions").innerHTML = optionGroup("size").choices.map((c) => `
                          <label class="cf-size" data-size="${c.value}">
                            <input type="radio" name="size" value="${c.value}" ${c.value === state.options.size ? "checked" : ""} />
                            <span class="cf-size-card">
                              <span class="cf-cup" aria-hidden="true"><i class="bi bi-cup-straw"></i></span>
                              <span class="cf-size-name">${c.value}</span>
                              <span class="cf-size-vol">${SIZE_VOLUMES[c.value] || ""}</span>
                              <span class="cf-size-price">${priceTag(c.price, "Base price")}</span>
                            </span>
                          </label>`).join("");

            // Milk pills
            $("#milkOptions").innerHTML = optionGroup("milk").choices.map((c) => `
                          <label class="cf-milk">
                            <input type="radio" name="milk" value="${c.value}" ${c.value === state.options.milk ? "checked" : ""} />
                            <span>${MILK_LABELS[c.value] || c.value} ${c.price ? `<small>+${formatMoney(c.price)}</small>` : ""}</span>
                          </label>`).join("");

            // Add-ons: extra shot (yes/no) + one syrup (choose one or none)
            const shotPrice = extraFor("extraShot", "Yes");
            const syrups = optionGroup("syrup").choices.filter((c) => c.value !== "None");
            $("#addonOptions").innerHTML = `
                          <label class="cf-addon">
                            <input type="checkbox" name="extraShot" value="Yes" />
                            <span class="cf-addon-card">
                              <span class="cf-addon-icon"><i class="bi bi-lightning-charge"></i></span>
                              <span class="cf-addon-text"><strong>Extra Espresso Shot</strong><small>+${formatMoney(shotPrice)}</small></span>
                              <span class="cf-check"><i class="bi bi-check-lg"></i></span>
                            </span>
                          </label>
                          <span class="cf-addon-group-label">Add a syrup <span class="text-lowercase fw-normal">(choose one)</span></span>
                          ${syrups.map((c) => `
                            <label class="cf-addon">
                              <input type="checkbox" name="syrup" value="${c.value}" />
                              <span class="cf-addon-card">
                                <span class="cf-addon-icon"><i class="bi bi-droplet-half"></i></span>
                                <span class="cf-addon-text"><strong>${c.value} Syrup</strong><small>+${formatMoney(c.price)}</small></span>
                                <span class="cf-check"><i class="bi bi-check-lg"></i></span>
                              </span>
                            </label>`).join("")}`;
        }

        /** Reads the form into the shared option shape: { size, milk, extraShot, syrup }. */
        function readOptions() {
            if (!product.customizable) return null;
            const form = $("#customizeForm");
            const syrup = form.querySelector('input[name="syrup"]:checked');
            return {
                size: (form.querySelector('input[name="size"]:checked') || {}).value || optionGroup("size").default,
                milk: (form.querySelector('input[name="milk"]:checked') || {}).value || optionGroup("milk").default,
                extraShot: form.querySelector('input[name="extraShot"]').checked ? "Yes" : "No",
                syrup: syrup ? syrup.value : "None",
            };
        }

        /** Builds the visible breakdown and returns the unit + total price. */
        function renderPrice() {
            state.options = readOptions();
            const unitPrice = priceWithOptions(product, state.options);
            const total = unitPrice * state.quantity;
            const rows = [`<li><span>Base Price</span><span>${formatMoney(product.price)}</span></li>`];

            if (state.options) {
                const o = state.options;
                rows.push(`<li><span>${o.size} Size <small class="text-muted">(${SIZE_VOLUMES[o.size]})</small></span><span>${priceTag(extraFor("size", o.size))}</span></li>`);
                rows.push(`<li><span>${MILK_LABELS[o.milk]}</span><span>${priceTag(extraFor("milk", o.milk))}</span></li>`);
                if (o.extraShot === "Yes") rows.push(`<li><span>Extra Espresso Shot</span><span>+${formatMoney(extraFor("extraShot", "Yes"))}</span></li>`);
                if (o.syrup !== "None") rows.push(`<li><span>${o.syrup} Syrup</span><span>+${formatMoney(extraFor("syrup", o.syrup))}</span></li>`);
            }
            if (state.quantity > 1 || state.options) {
                rows.push(`<li class="cf-bd-unit"><span>Price per item${state.quantity > 1 ? ` × ${state.quantity}` : ""}</span><span>${formatMoney(unitPrice)}</span></li>`);
            }

            $("#breakdownList").innerHTML = rows.join("");
            $("#totalPrice").textContent = formatMoney(total);
            $("#qtyValue").textContent = state.quantity;
            $("#qtyDec").disabled = state.quantity <= 1;
            $("#qtyInc").disabled = state.quantity >= 20;
            $("#mobileTotal").textContent = formatMoney(total);
            $("#mobileLabel").textContent = `${state.quantity} × ${product.name}`;
            return { unitPrice, total };
        }

        /* ---------- 7. ADD TO CART ---------- */
        const cartDrawer = () => bootstrap.Offcanvas.getOrCreateInstance($("#cartDrawer"));

        function addToCart() {
            const options = readOptions();
            Cart.add(product, { options, quantity: state.quantity });

            const btn = $("#addToCartBtn");
            btn.classList.add("added");
            btn.innerHTML = `<i class="bi bi-check-lg"></i> Added to Your Cart`;
            btn.disabled = true;
            setTimeout(() => {
                btn.classList.remove("added");
                btn.innerHTML = `<i class="bi bi-bag-heart"></i> Add to My Sweet Cart`;
                btn.disabled = false;
            }, 1300);

            const cc = $("#cartCount");
            cc.classList.add("bump");
            setTimeout(() => cc.classList.remove("bump"), 300);
            showToast(`${state.quantity > 1 ? state.quantity + " × " : ""}${product.name} added to your sweet cart`);
            setTimeout(() => cartDrawer().show(), 450);
        }

        /* ---------- 8. RELATED PRODUCTS ---------- */
        /** Pairing rules: drinks suggest sweets, food suggests drinks. */
        const PAIRS = {
            hot: ["cakes", "bakery", "signature", "iced"],
            iced: ["cakes", "signature", "bakery", "hot"],
            signature: ["signature", "cakes", "iced", "bakery"],
            cakes: ["signature", "hot", "cakes", "iced"],
            bakery: ["hot", "bakery", "signature", "cakes"],
            snacks: ["iced", "hot", "snacks", "signature"],
        };

        function relatedProducts() {
            const order = PAIRS[product.category] || [];
            const rank = (p) => { const i = order.indexOf(p.category); return i === -1 ? 99 : i; };
            const pool = PRODUCTS.filter((p) => p.id !== product.id);
            // Take the most popular item from each preferred category first, then fill up.
            const picks = [];
            order.forEach((catId) => {
                const best = pool.filter((p) => p.category === catId && !picks.includes(p)).sort((a, b) => b.popularity - a.popularity)[0];
                if (best && picks.length < 4) picks.push(best);
            });
            pool.sort((a, b) => rank(a) - rank(b) || b.popularity - a.popularity)
                .forEach((p) => { if (picks.length < 4 && !picks.includes(p)) picks.push(p); });
            return picks;
        }

        function renderRelated() {
            $("#relatedGrid").innerHTML = relatedProducts().map((p) => {
                const liked = Favorites.has(p.id);
                return `
                            <div class="col-12 col-sm-6 col-lg-3">
                              <article class="cf-product-card">
                                <div class="cf-product-img">
                                  <a href="${detailUrl(p.id)}" class="cf-product-img-link" aria-label="View ${p.name} details">
                                    <img src="${p.image}" alt="${p.name}" loading="lazy" data-fallback="${p.category}" />
                                  </a>
                                  ${p.badge ? `<span class="cf-tag ${BADGES[p.badge]}">${p.badge}</span>` : ""}
                                  <button type="button" class="cf-fav${liked ? " liked" : ""}" data-fav="${p.id}" aria-pressed="${liked}" aria-label="${liked ? "Remove from" : "Add to"} favorites">
                                    <i class="bi ${liked ? "bi-heart-fill" : "bi-heart"}"></i>
                                  </button>
                                </div>
                                <div class="cf-product-body">
                                  <div class="cf-product-meta"><span class="cf-cat-label">${category(p.category).label}</span></div>
                                  <h3><a href="${detailUrl(p.id)}">${p.name}</a></h3>
                                  <p>${p.description}</p>
                                  <div class="cf-product-foot">
                                    <span class="cf-price">${p.customizable ? "<small>from</small>" : ""}${formatMoney(p.price)}</span>
                                    ${p.customizable
                        ? `<a href="${detailUrl(p.id)}" class="btn cf-add-btn"><i class="bi bi-sliders"></i> Customize</a>`
                        : `<button type="button" class="btn cf-add-btn" data-add="${p.id}"><i class="bi bi-bag-plus"></i> Add</button>`}
                                  </div>
                                </div>
                              </article>
                            </div>`;
            }).join("");
            applyFallbacks($("#relatedGrid"));
        }

        /* ---------- 9. CART DRAWER (same rendering as Products Page) ---------- */
        const describeOptions = (o) => {
            if (!o) return "";
            const parts = [o.size, o.milk !== "Regular" ? `${o.milk} milk` : "Regular milk"];
            if (o.extraShot === "Yes") parts.push("Extra shot");
            if (o.syrup && o.syrup !== "None") parts.push(`${o.syrup} syrup`);
            return parts.join(" · ");
        };

        function renderCart() {
            const count = Cart.count();
            $("#cartCount").textContent = count;
            $("#cartDrawerCount").textContent = count ? `(${count})` : "";
            $("#cartItemCount").textContent = count;
            $("#cartTotal").textContent = formatMoney(Cart.subtotal());
            const empty = Cart.items.length === 0;
            $("#cartEmpty").classList.toggle("d-none", !empty);
            $("#cartFooter").classList.toggle("d-none", empty);

            $("#cartItems").innerHTML = Cart.items.map((line) => {
                const p = findProduct(line.productId);
                return `
                            <li class="cf-cart-line" data-line="${line.lineId}">
                              <a href="${detailUrl(line.productId)}" class="cf-cart-thumb">
                                <img src="${line.image}" alt="${line.name}" data-fallback="${p ? p.category : "coffee"}" />
                              </a>
                              <div>
                                <div class="cf-cart-line-top">
                                  <h6>${line.name}</h6>
                                  <button type="button" class="cf-cart-remove" data-action="remove" aria-label="Remove ${line.name}"><i class="bi bi-trash3"></i></button>
                                </div>
                                <div class="cf-cart-opts">${describeOptions(line.options) || `${formatMoney(line.unitPrice)} each`}</div>
                                <div class="cf-cart-line-bottom">
                                  <div class="cf-stepper">
                                    <button type="button" data-action="dec" aria-label="Decrease ${line.name}"><i class="bi bi-dash"></i></button>
                                    <span>${line.quantity}</span>
                                    <button type="button" data-action="inc" aria-label="Increase ${line.name}"><i class="bi bi-plus"></i></button>
                                  </div>
                                  <span class="cf-line-price">${formatMoney(line.unitPrice * line.quantity)}</span>
                                </div>
                              </div>
                            </li>`;
            }).join("");
            applyFallbacks($("#cartItems"));
        }

        /* ---------- 10. PAGE BOOTSTRAP ---------- */
        // Navbar behaviour (same as other pages)
        const nav = $("#mainNav");
        const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 30);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        const navCollapse = $("#navLinks");
        $$(".nav-link", navCollapse).forEach((link) =>
            link.addEventListener("click", () => {
                if (navCollapse.classList.contains("show")) bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
            })
        );

        // Cart drawer actions
        $("#cartItems").addEventListener("click", (e) => {
            const btn = e.target.closest("[data-action]");
            if (!btn) return;
            const lineId = btn.closest("[data-line]").dataset.line;
            const line = Cart.items.find((l) => l.lineId === lineId);
            if (!line) return;
            if (btn.dataset.action === "inc") Cart.setQuantity(lineId, line.quantity + 1);
            if (btn.dataset.action === "dec") Cart.setQuantity(lineId, line.quantity - 1);
            if (btn.dataset.action === "remove") { Cart.remove(lineId); showToast(`${line.name} removed from your cart`); }
        });
        document.addEventListener("cart:changed", renderCart);

        // Keep cart and favorites in sync with other open tabs
        window.addEventListener("storage", (e) => {
            if (e.key === STORAGE_KEYS.cart) { Cart.items = storage.read(STORAGE_KEYS.cart, []); renderCart(); }
            if (e.key === STORAGE_KEYS.favorites && product) { Favorites.reload(); renderFavorite(); renderRelated(); }
        });

        // Newsletter
        $("#newsletterForm").addEventListener("submit", (e) => {
            e.preventDefault();
            e.target.reset();
            showToast("Thanks! You're on the sweet list.");
        });

        // Open / closed status + year
        const now = new Date();
        const hours = { 0: [9 * 60, 20 * 60], 6: [8 * 60 + 30, 22 * 60] };
        const [open, close] = hours[now.getDay()] || [7 * 60 + 30, 21 * 60];
        const mins = now.getHours() * 60 + now.getMinutes();
        if (mins < open || mins >= close) {
            const status = $("#openStatus");
            status.classList.add("closed");
            status.innerHTML = '<span class="cf-dot"></span> Closed now';
        }
        $("#year").textContent = now.getFullYear();

        renderCart();

        if (!product) {
            renderNotFound();
            return;
        }

        // Product page
        ["#productSection", "#tabsSection", "#relatedSection"].forEach((s) => $(s).classList.remove("d-none"));
        renderHeader();
        renderGallery();
        renderInfo();
        renderFavorite();
        renderCustomization();
        renderTabs();
        renderRelated();
        renderPrice();

        const form = $("#customizeForm");

        // Syrups behave like "choose one or none"
        form.addEventListener("change", (e) => {
            if (e.target.name === "syrup" && e.target.checked) {
                $$('input[name="syrup"]', form).forEach((i) => { if (i !== e.target) i.checked = false; });
            }
            renderPrice();
        });

        $("#qtyInc").addEventListener("click", () => { state.quantity = Math.min(20, state.quantity + 1); renderPrice(); });
        $("#qtyDec").addEventListener("click", () => { state.quantity = Math.max(1, state.quantity - 1); renderPrice(); });
        form.addEventListener("submit", (e) => { e.preventDefault(); addToCart(); });
        $("#mobileAdd").addEventListener("click", addToCart);

        // Favorite on the main image
        $("#favBtn").addEventListener("click", () => {
            const liked = Favorites.toggle(product.id);
            renderFavorite();
            const btn = $("#favBtn");
            btn.classList.remove("pop"); void btn.offsetWidth; btn.classList.add("pop");
            showToast(liked ? `${product.name} saved to favorites` : `${product.name} removed from favorites`);
        });

        // Related products: favorites + quick add
        $("#relatedGrid").addEventListener("click", (e) => {
            const fav = e.target.closest("[data-fav]");
            if (fav) {
                const p = findProduct(Number(fav.dataset.fav));
                const liked = Favorites.toggle(p.id);
                fav.classList.toggle("liked", liked);
                fav.setAttribute("aria-pressed", liked);
                fav.querySelector("i").className = `bi ${liked ? "bi-heart-fill" : "bi-heart"}`;
                fav.classList.remove("pop"); void fav.offsetWidth; fav.classList.add("pop");
                showToast(liked ? `${p.name} saved to favorites` : `${p.name} removed from favorites`);
                return;
            }
            const add = e.target.closest("[data-add]");
            if (add) {
                const p = findProduct(Number(add.dataset.add));
                Cart.add(p);
                showToast(`${p.name} added to your cart`);
            }
        });

        // Rating link jumps to the Reviews tab
        $("#ratingLink").addEventListener("click", () => {
            bootstrap.Tab.getOrCreateInstance($("#tab-rev")).show();
            $("#tabsSection").scrollIntoView({ behavior: "smooth", block: "start" });
        });

        // Mobile add bar: visible once the main Add button scrolls out of view
        const mobileBar = $("#mobileBar");
        if ("IntersectionObserver" in window) {
            new IntersectionObserver(([entry]) => {
                const hide = entry.isIntersecting;
                mobileBar.classList.toggle("hide", hide);
                document.body.classList.toggle("has-mobile-bar", !hide);
            }).observe($("#addToCartBtn"));
        } else {
            mobileBar.classList.remove("hide");
        }
    })();
</script>