        const PRODUCTS = [
            { id: 1, name: "Classic Cappuccino", category: "hot", price: 145, image: IMG("1572442388796-11668a67e53d"), description: "Rich double espresso under a deep layer of velvety milk foam.", badge: null, vegetarian: true, popularity: 88, customizable: true },
            { id: 2, name: "Vanilla Latte", category: "hot", price: 160, image: IMG("1509042239860-f550ce710b93"), description: "Smooth espresso and steamed milk with Madagascar vanilla.", badge: "Best Seller", vegetarian: true, popularity: 95, customizable: true },
            { id: 3, name: "Caramel Macchiato", category: "hot", price: 170, image: IMG("1485808191679-5f86510681a2"), description: "Vanilla milk marked with espresso and a buttery caramel drizzle.", badge: "Popular", vegetarian: true, popularity: 90, customizable: true },
            { id: 4, name: "Iced Spanish Latte", category: "iced", price: 175, image: IMG("1461023058943-07fcbe16d735"), description: "Espresso over ice with creamy condensed milk sweetness.", badge: "Best Seller", vegetarian: true, popularity: 96, customizable: true },
            { id: 5, name: "Iced Mocha", category: "iced", price: 180, image: IMG("1517701604599-bb29b565090c"), description: "Double espresso, Belgian chocolate and cold milk over ice.", badge: null, vegetarian: true, popularity: 82, customizable: true },
            { id: 6, name: "Cold Brew", category: "iced", price: 155, image: IMG("1534778101976-62847782c213"), description: "Slow-steeped for 18 hours. Smooth, bold and naturally sweet.", badge: null, vegetarian: true, popularity: 74, customizable: false },
            { id: 7, name: "Strawberry Cloud Latte", category: "signature", price: 205, image: IMG("1572490122747-3968b75cc699"), description: "Fresh strawberry milk, espresso and a cloud of pink cold foam.", badge: "Best Seller", vegetarian: true, popularity: 99, customizable: true },
            { id: 8, name: "Rose Matcha", category: "signature", price: 210, image: IMG("1515823064-d6e0c04616a7"), description: "Ceremonial matcha with a delicate rose syrup and oat milk.", badge: "New", vegetarian: true, popularity: 85, customizable: true },
            { id: 9, name: "Pink Berry Frappe", category: "signature", price: 215, image: IMG("1553530666-ba11a7da3888"), description: "Blended raspberry, strawberry and vanilla cream with whipped top.", badge: "Popular", vegetarian: true, popularity: 91, customizable: false },
            { id: 10, name: "Pink Velvet Cake", category: "cakes", price: 225, image: IMG("1578985545062-69928b1d9587"), description: "Rose-tinted sponge layered with vanilla cream cheese frosting.", badge: "Chef's Choice", vegetarian: true, popularity: 93, customizable: false },
            { id: 11, name: "Lotus Cheesecake", category: "cakes", price: 245, image: IMG("1533134242443-d4fd215305ad"), description: "Baked cheesecake on a Biscoff crumb with caramel drizzle.", badge: "Best Seller", vegetarian: true, popularity: 97, customizable: false },
            { id: 12, name: "Strawberry Shortcake", category: "cakes", price: 230, image: IMG("1565958011703-44f9829ba187"), description: "Light chiffon, fresh strawberries and whipped mascarpone.", badge: "New", vegetarian: true, popularity: 80, customizable: false },
            { id: 13, name: "Raspberry Macarons", category: "cakes", price: 180, image: IMG("1569864358642-9d1684040f43"), description: "Box of four almond macarons with tangy raspberry ganache.", badge: null, vegetarian: true, popularity: 76, customizable: false },
            { id: 14, name: "Butter Croissant", category: "bakery", price: 95, image: IMG("1555507036-ab1f4038808a"), description: "Flaky, golden and laminated with French butter every morning.", badge: "Popular", vegetarian: true, popularity: 89, customizable: false },
