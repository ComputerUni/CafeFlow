@using CafeFlow.DTO.ProductDetail
@model ResultProductDetailDto


<!-- ============ PRODUCT ============ -->
<section class="cf-detail-section" id="productSection" aria-labelledby="productName">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <!-- Gallery -->
                <div class="cf-gallery-main" id="galleryMain">
                    <img src="@Model.ImageUrl" alt="@Model.Name" id="mainImage" class="cf-gallery-img" data-fallback="@(Model.CategoryName?.ToLower() ?? "coffee")" />

                    @if (Model.IsFeatured)
                    {
                        <span class="cf-tag cf-tag-best" id="productBadge">Öne Çıkan</span>
                    }
                    <button type="button" class="cf-fav" id="favBtn" data-fav="@Model.Id" aria-pressed="false" aria-label="Favorilere Ekle">
                        <i class="bi bi-heart"></i>
                    </button>
                    <span class="cf-gallery-caption" id="galleryCaption"><i class="bi bi-zoom-in"></i> Yakınlaştırmak için üzerine gelin</span>
                </div>
            </div>
           

            <!-- Info & customization -->
            <div class="col-lg-6">
                <span class="cf-info-cat" id="productCategory"><i class="bi bi-stars"></i> @Model.CategoryName</span>
                <h1 class="cf-info-title" id="productName">@Model.Name</h1>

                <div class="cf-meta-row">
                    <button type="button" class="cf-rating-link" id="ratingLink">
                        <span class="d-inline-flex align-items-center gap-2" style="text-decoration:none;color:inherit">
                            <span class="cf-stars" id="ratingStars"></span>
                            <strong id="ratingValue">5.0</strong>/5
                        </span>
                        <span id="reviewCountLabel">(@(Model.Comments?.Count ?? 0) değerlendirme)</span>
                    </button>
                    <span class="cf-stock"><span class="cf-dot"></span> @Model.Stock adet</span>
                </div>

                <p class="cf-info-desc" id="productShortDesc">@Model.Description</p>

                <div class="cf-price-hero">
                    <small id="priceLabel">@(Model.IsCustomizable == true ? "Başlangıç" : "Fiyat")</small>
                    <strong id="basePrice">₺@Model.Price.ToString("N2")</strong>
                    @if (Model.IsCustomizable == true)
                    {
                        <span class="cf-price-note" id="customNote"><i class="bi bi-sliders"></i> Özelleştirilebilir</span>
                    }
                </div>

                <form id="customizeForm">
                    <!-- Customization (only for customizable products) -->
                    <div id="customSections" class="@(Model.IsCustomizable == true ? "": "d-none")">
                        <fieldset class="cf-opt-section">
                            <legend>Boyut Tercihi</legend>
                            <div class="cf-size-grid" id="sizeOptions"></div>
                        </fieldset>

                        <fieldset class="cf-opt-section">
                            <legend>Süt Tercihi</legend>
                            <p class="cf-opt-subtitle">İçeceğinizi damak tadınıza uygun süt ile taçlandırın.</p>
                            <div class="cf-milk-row" id="milkOptions"></div>
                        </fieldset>

                        <fieldset class="cf-opt-section">
                            <legend>Ekstra Lezzet Dokunuşu</legend>
                            <p class="cf-opt-subtitle">İçeceğinizi daha özel kılacak dokunuşlar.</p>
                            <div class="cf-addon-grid" id="addonOptions"></div>
                        </fieldset>
                    </div>

                    <!-- Price breakdown -->
                    <div class="cf-breakdown" aria-live="polite">
                        <ul id="breakdownList"></ul>
                        <div class="cf-bd-total">
                            <span>Toplam</span>
                            <strong id="totalPrice">₺@Model.Price.ToString("N2")</strong>
                        </div>
                    </div>

                    <!-- Quantity + add -->
                    <div class="cf-buy-row">
                        <div class="cf-stepper" role="group" aria-label="Adet">
                            <button type="button" id="qtyDec" aria-label="Azalt"><i class="bi bi-dash"></i></button>
                            <span id="qtyValue" aria-live="polite">1</span>
                            <button type="button" id="qtyInc" aria-label="Artır"><i class="bi bi-plus"></i></button>
                        </div>
                        <button type="submit" class="btn cf-btn-primary cf-btn-lg cf-add-main" id="addToCartBtn">
                            <i class="bi bi-bag-heart"></i> Sepete Ekle
                        </button>
                    </div>
                    <a href="/Menu/Index" class="cf-continue-explore"><i class="bi bi-arrow-left"></i> Menüyü İncelemeye Devam Et</a>
                </form>

                <div class="cf-assure">
                    <div class="cf-assure-item">
                        <i class="bi bi-fire"></i>
                        <div><strong>Taze Hazırlanır</strong><small>Sipariş anında demlenir ve pişirilir.</small></div>
                    </div>
                    <div class="cf-assure-item">
                        <i class="bi bi-heart"></i>
                        <div><strong>Sevgiyle Sunulur</strong><small>Baristalarımızın özenli dokunuşuyla.</small></div>
                    </div>
                    <div class="cf-assure-item">
                        <i class="bi bi-bag-check"></i>
                        <div><strong>Gel-Al, Paket &amp; Masadan</strong><small>Nasıl arzu ederseniz.</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>