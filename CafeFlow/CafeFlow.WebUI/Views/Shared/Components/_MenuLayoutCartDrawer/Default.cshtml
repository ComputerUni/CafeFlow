<!-- ============ CART DRAWER ============ -->
<div class="offcanvas offcanvas-end cf-cart-drawer" tabindex="-1" id="cartDrawer" aria-labelledby="cartTitle">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="cartTitle"><i class="bi bi-bag-heart"></i> Your Sweet Cart <small id="cartDrawerCount"></small></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div id="cartEmpty" class="cf-cart-empty">
            <span class="cf-cat-icon"><i class="bi bi-bag-heart"></i></span>
            <h6>Your cart is feeling light</h6>
            <p>Add a latte or a little slice of happiness.</p>
            <button type="button" class="btn cf-btn-outline" data-bs-dismiss="offcanvas">Browse the menu</button>
        </div>

        <ul id="cartItems" class="cf-cart-items"></ul>

        <div id="cartFooter" class="cf-cart-footer d-none">
            <ul class="cf-cart-summary">
                <li><span>Ürünler</span><span id="cartItemCount">0</span></li>
                <li class="cf-sum-total"><span>Ara Toplam</span><strong id="cartTotal">₺0,00</strong></li>
            </ul>
            <div class="d-grid gap-2">
                <a href="/Cart/Index" class="btn cf-btn-primary cf-btn-lg">Sepeti Görüntüle &amp; Ödeme <i class="bi bi-arrow-right"></i></a>
                <button type="button" class="btn cf-btn-outline" data-bs-dismiss="offcanvas">Alışverişe Devam Et</button>
            </div>
        </div>
    </div>
</div>