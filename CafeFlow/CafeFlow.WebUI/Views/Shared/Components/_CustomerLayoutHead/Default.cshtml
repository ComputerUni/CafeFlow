<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CafeFlow — Boutique Café & Online Ordering</title>
    <meta name="description" content="CafeFlow is a boutique café serving handcrafted coffee and desserts. Order online, from your table with QR, or for pickup." />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Styles -->
    <style>
            /* =========================================================
                           CafeFlow — Homepage Styles
                           ========================================================= */

            /* ---------- Design tokens ---------- */
            :root {
                --cf-pink-50: #fff6f8;
                --cf-pink-100: #fde8ee;
                --cf-pink-200: #f9d3de;
                --cf-pink-300: #f4b8c9;
                --cf-rose: #e88ea6;
                --cf-rose-deep: #d46f8c;
                --cf-peach: #ffe4d6;
                --cf-cream: #fdf8f2;
                --cf-offwhite: #fffcfa;
                --cf-coffee: #6b4a3a;
                --cf-coffee-2: #9a7462;
                --cf-ink: #3d2a24;
                --cf-muted: #8a7470;
                --cf-radius-sm: 12px;
                --cf-radius: 20px;
                --cf-radius-lg: 32px;
                --cf-shadow-sm: 0 4px 14px rgba(212, 111, 140, 0.08);
                --cf-shadow: 0 14px 40px rgba(212, 111, 140, 0.12);
                --cf-shadow-lg: 0 24px 60px rgba(150, 80, 100, 0.16);
                --cf-font-display: "Playfair Display", Georgia, serif;
                --cf-font-body: "DM Sans", system-ui, -apple-system, sans-serif;
                --cf-ease: cubic-bezier(.2, .8, .2, 1);
            }

            /* ---------- Base ---------- */
            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--cf-font-body);
                color: var(--cf-ink);
                background: var(--cf-offwhite);
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }

            h1, h2, h3, h4, h5 {
                color: var(--cf-ink);
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            img {
                max-width: 100%;
                display: block;
            }

            ::selection {
                background: var(--cf-pink-200);
            }

            .cf-section {
                padding: 110px 0;
                position: relative;
            }

            .cf-section-tint {
                background: linear-gradient(180deg, var(--cf-pink-50), #fff 100%);
            }

            .cf-section-cream {
                background: var(--cf-cream);
            }

            .cf-section-head {
                text-align: center;
                max-width: 640px;
                margin: 0 auto 56px;
            }

                .cf-section-head.d-md-flex {
                    max-width: none;
                }

            .cf-eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: .78rem;
                font-weight: 600;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--cf-rose-deep);
                margin-bottom: 14px;
            }

            .cf-section-title {
                font-family: var(--cf-font-display);
                font-weight: 600;
                font-size: clamp(2rem, 3.6vw, 2.9rem);
                line-height: 1.15;
                margin-bottom: 16px;
            }

            .cf-section-sub, .cf-body-lg {
                color: var(--cf-muted);
                font-size: 1.08rem;
                line-height: 1.75;
            }

            /* ---------- Buttons ---------- */
            .btn {
                font-weight: 600;
                border-radius: 999px;
                padding: 11px 24px;
                transition: all .35s var(--cf-ease);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .cf-btn-lg {
                padding: 15px 30px;
                font-size: 1rem;
            }

            .cf-btn-primary {
                background: linear-gradient(135deg, var(--cf-rose), var(--cf-rose-deep));
                color: #fff;
                border: none;
                box-shadow: 0 10px 24px rgba(212, 111, 140, .3);
            }

                .cf-btn-primary:hover, .cf-btn-primary:focus {
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 16px 32px rgba(212, 111, 140, .4);
                }

            .cf-btn-outline {
                background: #fff;
                color: var(--cf-coffee);
                border: 1.5px solid var(--cf-pink-200);
            }

                .cf-btn-outline:hover {
                    background: var(--cf-pink-100);
                    border-color: var(--cf-pink-300);
                    color: var(--cf-coffee);
                    transform: translateY(-2px);
                }

            .cf-btn-dark {
                background: var(--cf-coffee);
                color: #fff;
                border: none;
            }

                .cf-btn-dark:hover {
                    background: var(--cf-ink);
                    color: #fff;
                    transform: translateY(-2px);
                }

            .cf-text-link {
                font-weight: 600;
                color: var(--cf-rose-deep);
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .cf-text-link i {
                    transition: transform .3s var(--cf-ease);
                }

                .cf-text-link:hover {
                    color: var(--cf-coffee);
                }

                    .cf-text-link:hover i {
                        transform: translateX(4px);
                    }

            /* ---------- Navbar ---------- */
            .cf-navbar {
                padding: 18px 0;
                transition: all .4s var(--cf-ease);
                background: transparent;
            }

                .cf-navbar.scrolled {
                    padding: 10px 0;
                    background: rgba(255, 252, 250, .85);
                    backdrop-filter: blur(14px);
                    -webkit-backdrop-filter: blur(14px);
                    box-shadow: 0 6px 30px rgba(212, 111, 140, .08);
                }

            .cf-logo {
                font-family: var(--cf-font-display);
                font-weight: 700;
                font-size: 1.55rem;
                color: var(--cf-coffee);
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }

                .cf-logo span:not(.cf-logo-mark) {
                    color: var(--cf-rose-deep);
                }

                .cf-logo:hover {
                    color: var(--cf-coffee);
                }

            .cf-logo-mark {
                width: 40px;
                height: 40px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                background: linear-gradient(135deg, var(--cf-pink-200), var(--cf-peach));
                color: var(--cf-rose-deep);
                font-size: 1.1rem;
            }

            .cf-nav-links .nav-link {
                font-weight: 500;
                color: var(--cf-coffee-2);
                padding: 8px 18px !important;
                border-radius: 999px;
                transition: all .3s var(--cf-ease);
            }

                .cf-nav-links .nav-link:hover {
                    color: var(--cf-rose-deep);
                }

                .cf-nav-links .nav-link.active {
                    color: var(--cf-rose-deep);
                    background: var(--cf-pink-100);
                }

            .cf-cart-btn {
                background: #fff;
                border: 1.5px solid var(--cf-pink-200);
                color: var(--cf-coffee);
                position: relative;
                padding: 9px 18px;
            }

                .cf-cart-btn:hover {
                    background: var(--cf-pink-50);
                    color: var(--cf-rose-deep);
                }

                .cf-cart-btn i {
                    font-size: 1.1rem;
                }

            .cf-cart-count {
                min-width: 22px;
                height: 22px;
                border-radius: 999px;
                background: var(--cf-rose-deep);
                color: #fff;
                font-size: .72rem;
                display: grid;
                place-items: center;
                padding: 0 6px;
                transition: transform .3s var(--cf-ease);
            }

                .cf-cart-count.bump {
                    transform: scale(1.35);
                }

            .cf-toggler {
                border: none;
                font-size: 1.6rem;
                color: var(--cf-coffee);
                padding: 4px 8px;
            }

                .cf-toggler:focus {
                    box-shadow: none;
                }

            /* ---------- Hero ---------- */
            .cf-hero {
                padding: 170px 0 110px;
                background: radial-gradient(1200px 600px at 85% 10%, var(--cf-pink-100), transparent 60%), radial-gradient(900px 500px at 0% 100%, var(--cf-peach), transparent 60%), var(--cf-offwhite);
                position: relative;
                overflow: hidden;
            }

            .cf-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(60px);
                opacity: .55;
                pointer-events: none;
            }

            .cf-blob-1 {
                width: 380px;
                height: 380px;
                background: var(--cf-pink-200);
                top: -80px;
                right: 20%;
                animation: cf-float 14s ease-in-out infinite;
            }

            .cf-blob-2 {
                width: 300px;
                height: 300px;
                background: var(--cf-peach);
                bottom: -60px;
                left: -60px;
                animation: cf-float 18s ease-in-out infinite reverse;
            }

            .cf-hero-title {
                font-family: var(--cf-font-display);
                font-weight: 600;
                font-size: clamp(2.7rem, 6vw, 4.6rem);
                line-height: 1.05;
                letter-spacing: -.01em;
                margin-bottom: 24px;
            }

                .cf-hero-title em {
                    font-style: italic;
                    color: var(--cf-rose-deep);
                    position: relative;
                }

                    .cf-hero-title em::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: 6px;
                        height: 12px;
                        background: var(--cf-pink-200);
                        opacity: .6;
                        z-index: -1;
                        border-radius: 6px;
                    }

            .cf-hero-text {
                font-size: 1.15rem;
                line-height: 1.75;
                color: var(--cf-muted);
                max-width: 520px;
                margin-bottom: 36px;
            }

            .cf-hero-stats {
                display: flex;
                align-items: center;
                gap: 28px;
                flex-wrap: wrap;
            }

                .cf-hero-stats strong {
                    display: block;
                    font-family: var(--cf-font-display);
                    font-size: 1.7rem;
                    color: var(--cf-coffee);
                }

                .cf-hero-stats span {
                    font-size: .88rem;
                    color: var(--cf-muted);
                }

                .cf-hero-stats .bi-star-fill {
                    color: #f2b45a;
                }

            .cf-stat-divider {
                width: 1px;
                height: 40px;
                background: var(--cf-pink-200);
            }

            .cf-hero-visual {
                position: relative;
                max-width: 500px;
                margin: 0 auto;
            }

            .cf-hero-arch {
                border-radius: 260px 260px var(--cf-radius-lg) var(--cf-radius-lg);
                overflow: hidden;
                aspect-ratio: 4 / 5;
                box-shadow: var(--cf-shadow-lg);
                border: 10px solid #fff;
                background: var(--cf-pink-100);
            }

                .cf-hero-arch img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .cf-float-card {
                position: absolute;
                display: flex;
                align-items: center;
                gap: 12px;
                background: rgba(255, 255, 255, .92);
                backdrop-filter: blur(10px);
                padding: 12px 18px 12px 12px;
                border-radius: 18px;
                box-shadow: var(--cf-shadow);
                animation: cf-float 6s ease-in-out infinite;
            }

                .cf-float-card small {
                    display: block;
                    font-size: .74rem;
                    color: var(--cf-muted);
                }

                .cf-float-card strong {
                    font-size: .95rem;
                    color: var(--cf-coffee);
                }

            .cf-float-1 {
                top: 18%;
                left: -40px;
            }

            .cf-float-2 {
                bottom: 14%;
                right: -30px;
                animation-delay: -3s;
            }

            .cf-float-icon {
                width: 42px;
                height: 42px;
                border-radius: 13px;
                display: grid;
                place-items: center;
                background: var(--cf-pink-100);
                color: var(--cf-rose-deep);
                font-size: 1.1rem;
            }

            .cf-hero-badge {
                position: absolute;
                top: -10px;
                right: 10px;
                width: 92px;
                height: 92px;
                border-radius: 50%;
                background: var(--cf-coffee);
                color: #fff;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                box-shadow: var(--cf-shadow);
                border: 4px solid #fff;
            }

                .cf-hero-badge span {
                    font-size: .7rem;
                    letter-spacing: .14em;
                    text-transform: uppercase;
                    opacity: .8;
                }

                .cf-hero-badge strong {
                    font-family: var(--cf-font-display);
                    font-size: 1.35rem;
                }

            /* ---------- Icon color variants ---------- */
            .cf-icon-peach {
                background: var(--cf-peach) !important;
                color: #c97a55 !important;
            }

            .cf-icon-cream {
                background: #f6ecdf !important;
                color: var(--cf-coffee) !important;
            }

            .cf-icon-rose {
                background: #fbe1e8 !important;
                color: #c25d7b !important;
            }

            /* ---------- Category cards ---------- */
            .cf-category-card {
                display: block;
                height: 100%;
                background: #fff;
                border-radius: var(--cf-radius);
                padding: 34px 26px;
                border: 1px solid var(--cf-pink-100);
                box-shadow: var(--cf-shadow-sm);
                transition: all .45s var(--cf-ease);
                position: relative;
                overflow: hidden;
            }

                .cf-category-card::before {
                    content: "";
                    position: absolute;
                    inset: auto -40% -60% auto;
                    width: 200px;
                    height: 200px;
                    border-radius: 50%;
                    background: var(--cf-pink-50);
                    transition: transform .5s var(--cf-ease);
                    z-index: 0;
                }

                .cf-category-card > * {
                    position: relative;
                    z-index: 1;
                }

                .cf-category-card:hover {
                    transform: translateY(-8px);
                    box-shadow: var(--cf-shadow);
                    border-color: var(--cf-pink-200);
                }

                    .cf-category-card:hover::before {
                        transform: scale(1.6);
                    }

            .cf-cat-icon {
                width: 64px;
                height: 64px;
                border-radius: 20px;
                display: grid;
                place-items: center;
                font-size: 1.6rem;
                background: var(--cf-pink-100);
                color: var(--cf-rose-deep);
                margin-bottom: 22px;
            }

            .cf-category-card h3 {
                font-family: var(--cf-font-display);
                font-size: 1.35rem;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .cf-category-card p {
                color: var(--cf-muted);
                font-size: .94rem;
                line-height: 1.6;
                margin-bottom: 18px;
            }

            .cf-cat-link {
                font-size: .85rem;
                font-weight: 600;
                color: var(--cf-rose-deep);
            }

            /* ---------- Filter pills ---------- */
            .cf-filter {
                display: inline-flex;
                background: #fff;
                border-radius: 999px;
                padding: 5px;
                box-shadow: var(--cf-shadow-sm);
                border: 1px solid var(--cf-pink-100);
            }

                .cf-filter button {
                    border: none;
                    background: transparent;
                    padding: 9px 20px;
                    border-radius: 999px;
                    font-weight: 600;
                    font-size: .9rem;
                    color: var(--cf-coffee-2);
                    transition: all .3s var(--cf-ease);
                }

                    .cf-filter button.active {
                        background: var(--cf-rose-deep);
                        color: #fff;
                    }

                    .cf-filter button:not(.active):hover {
                        color: var(--cf-rose-deep);
                    }

            /* ---------- Product cards ---------- */
            .cf-product-card {
                background: #fff;
                border-radius: var(--cf-radius);
                overflow: hidden;
                height: 100%;
                display: flex;
                flex-direction: column;
                box-shadow: var(--cf-shadow-sm);
                border: 1px solid var(--cf-pink-100);
                transition: all .45s var(--cf-ease);
            }

                .cf-product-card:hover {
                    transform: translateY(-8px);
                    box-shadow: var(--cf-shadow);
                }

            .cf-product-img {
                position: relative;
                aspect-ratio: 4 / 3;
                overflow: hidden;
                margin: 10px 10px 0;
                border-radius: 16px;
                background: var(--cf-pink-100);
            }

                .cf-product-img img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform .8s var(--cf-ease);
                }

            .cf-product-card:hover .cf-product-img img {
                transform: scale(1.07);
            }

            .cf-tag {
                position: absolute;
                top: 14px;
                left: 14px;
                background: rgba(255, 255, 255, .95);
                color: var(--cf-rose-deep);
                font-size: .74rem;
                font-weight: 700;
                padding: 6px 12px;
                border-radius: 999px;
                letter-spacing: .03em;
            }

            .cf-fav {
                position: absolute;
                top: 12px;
                right: 12px;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                border: none;
                background: rgba(255, 255, 255, .95);
                color: var(--cf-rose-deep);
                display: grid;
                place-items: center;
                transition: transform .3s var(--cf-ease);
            }

                .cf-fav:hover {
                    transform: scale(1.1);
                }

                .cf-fav.liked i::before {
                    content: "\f415";
                }
            /* bi-heart-fill */

            .cf-product-body {
                padding: 20px 22px 24px;
                display: flex;
                flex-direction: column;
                flex: 1;
            }

            .cf-rating {
                font-size: .82rem;
                font-weight: 600;
                color: var(--cf-coffee-2);
                margin-bottom: 6px;
            }

                .cf-rating i {
                    color: #f2b45a;
                }

            .cf-product-body h3 {
                font-family: var(--cf-font-display);
                font-size: 1.3rem;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .cf-product-body p {
                color: var(--cf-muted);
                font-size: .93rem;
                line-height: 1.6;
                margin-bottom: 20px;
                flex: 1;
            }

            .cf-product-foot {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .cf-price {
                font-family: var(--cf-font-display);
                font-size: 1.45rem;
                font-weight: 700;
                color: var(--cf-coffee);
            }

            .cf-add-btn:not(.cf-btn-dark) {
                background: var(--cf-pink-100);
                color: var(--cf-rose-deep);
                border: none;
                padding: 10px 20px;
            }

                .cf-add-btn:not(.cf-btn-dark):hover {
                    background: var(--cf-rose-deep);
                    color: #fff;
                }

            .cf-add-btn.added {
                background: var(--cf-coffee) !important;
                color: #fff !important;
            }

            .cf-hidden {
                display: none !important;
            }

            /* ---------- Order cards ---------- */
            .cf-order-card {
                background: #fff;
                border-radius: var(--cf-radius-lg);
                padding: 42px 34px;
                height: 100%;
                position: relative;
                border: 1px solid var(--cf-pink-100);
                box-shadow: var(--cf-shadow-sm);
                transition: all .45s var(--cf-ease);
            }

                .cf-order-card:hover {
                    transform: translateY(-8px);
                    box-shadow: var(--cf-shadow);
                }

            .cf-order-featured {
                background: linear-gradient(160deg, var(--cf-pink-100), var(--cf-peach));
                border-color: transparent;
            }

            .cf-order-num {
                position: absolute;
                top: 28px;
                right: 32px;
                font-family: var(--cf-font-display);
                font-size: 2.6rem;
                font-weight: 700;
                color: var(--cf-pink-200);
                line-height: 1;
            }

            .cf-order-featured .cf-order-num {
                color: #fff;
            }

            .cf-order-icon {
                width: 70px;
                height: 70px;
                border-radius: 22px;
                display: grid;
                place-items: center;
                font-size: 1.8rem;
                background: var(--cf-pink-50);
                color: var(--cf-rose-deep);
                margin-bottom: 26px;
                border: 1px solid var(--cf-pink-100);
            }

            .cf-order-featured .cf-order-icon {
                background: #fff;
                border-color: #fff;
            }

            .cf-order-card h3 {
                font-family: var(--cf-font-display);
                font-size: 1.5rem;
                font-weight: 600;
                margin-bottom: 12px;
            }

            .cf-order-card p {
                color: var(--cf-muted);
                line-height: 1.7;
                margin-bottom: 22px;
            }

            .cf-order-featured p {
                color: var(--cf-coffee-2);
            }

            /* ---------- About ---------- */
            .cf-collage {
                position: relative;
                padding-right: 18%;
                padding-bottom: 14%;
            }

            .cf-collage-main {
                border-radius: var(--cf-radius-lg);
                overflow: hidden;
                aspect-ratio: 4 / 5;
                box-shadow: var(--cf-shadow);
                background: var(--cf-pink-100);
            }

                .cf-collage-main img, .cf-collage-side img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .cf-collage-side {
                position: absolute;
                right: 0;
                bottom: 0;
                width: 48%;
                aspect-ratio: 1;
                border-radius: 50%;
                overflow: hidden;
                border: 10px solid var(--cf-cream);
                box-shadow: var(--cf-shadow);
                background: var(--cf-peach);
            }

            .cf-collage-note {
                position: absolute;
                left: -14px;
                bottom: 22%;
                background: #fff;
                padding: 14px 20px;
                border-radius: 16px;
                box-shadow: var(--cf-shadow);
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: var(--cf-font-display);
                font-style: italic;
                color: var(--cf-coffee);
                max-width: 240px;
            }

                .cf-collage-note i {
                    color: var(--cf-rose-deep);
                    font-size: 1.3rem;
                }

            .cf-feature {
                display: flex;
                gap: 14px;
                background: #fff;
                padding: 18px;
                border-radius: var(--cf-radius-sm);
                height: 100%;
                border: 1px solid #f3e7da;
                transition: all .35s var(--cf-ease);
            }

                .cf-feature:hover {
                    border-color: var(--cf-pink-200);
                    box-shadow: var(--cf-shadow-sm);
                }

            .cf-feature-icon {
                flex-shrink: 0;
                width: 44px;
                height: 44px;
                border-radius: 14px;
