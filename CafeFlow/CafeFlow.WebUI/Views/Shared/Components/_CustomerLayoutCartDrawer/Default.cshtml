<div class="offcanvas offcanvas-end cf-cart-drawer" tabindex="-1" id="cartDrawer" aria-labelledby="cartTitle">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="cartTitle">
            <i class="bi bi-bag-heart"></i> Sepetim
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        <div id="cartEmpty" class="cf-cart-empty text-center my-auto">
            <span class="cf-cat-icon"><i class="bi bi-cup-hot"></i></span>
            <p class="mt-3 text-muted">
                Sepetiniz henüz boş.<br />
                Günün lezzetlerinden birini seçmeye ne dersiniz?
            </p>
            <a href="#products" class="btn cf-btn-outline mt-2" data-bs-dismiss="offcanvas">
                Lezzetleri İncele
            </a>
        </div>

        <ul id="cartItems" class="cf-cart-items list-unstyled flex-grow-1 overflow-auto my-3"></ul>

        <div id="cartFooter" class="cf-cart-footer d-none pt-3 border-top">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">Ara Toplam</span>
                <strong id="cartTotal" class="fs-5 text-dark">₺0,00</strong>
            </div>

            <a href="/Cart/Index" id="btnCheckout" class="btn cf-btn-primary w-100 cf-btn-lg text-center">
                Siparişi Tamamla <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>