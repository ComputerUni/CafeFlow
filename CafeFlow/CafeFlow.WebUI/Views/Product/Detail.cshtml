@model ProductDetailPageViewModel

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}


@await Component.InvokeAsync("_ProductDetailLayoutHead")

<div class="cf-detail-head">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <div class="cf-breadcrumb" id="breadcrumb">
                <a href="/Default/Index"><i class="bi bi-house-heart"></i> Anasayfa</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/Menu/Index">Menü</a>
            </div>
        </nav>
        <a href="/Menu/Index" class="cf-back-link" id="backLink"><span><i class="bi bi-arrow-left"></i></span> Menüye Dön</a>
    </div>
</div>

<main>
    @if(Model.Product == null)
    {
        <section class="cf-not-found container d-none" id="notFound">
            <div class="cf-empty-art"><span><i class="bi bi-search-heart"></i></span></div>
            <h1>Aradığınız lezzeti bulamadık</h1>
            <p>Bu ürün menümüzden ayrılmış olabilir veya bağlantı eksik olabilir.</p>
            <a href="/Menu/Index" class="btn cf-btn-primary cf-btn-lg">Menümüzdeki Ürünleri Keşfedin <i class="bi bi-arrow-right"></i></a>
        </section>
    } 


    @await Component.InvokeAsync("_ProductDetailLayoutProductInfo", new { product = Model.Product })

    @await Component.InvokeAsync("_ProductDetailLayoutCreateComment", new { productId = Model.Product.Id })

    @await Component.InvokeAsync("_ProductDetailLayoutInfoTabs")

    @await Component.InvokeAsync("_ProductDetailLayoutRelated")

</main>

<div class="cf-mobile-bar hide" id="mobileBar">
    <div>
        <small id="mobileLabel">1 × Product</small>
        <strong id="mobileTotal">₺0.00</strong>
    </div>
    <button type="button" class="btn cf-btn-primary" id="mobileAdd"><i class="bi bi-bag-heart"></i> Add to Cart</button>
</div>

@await Component.InvokeAsync("_ProductDetailLayoutFooter")

@await Component.InvokeAsync("_MenuLayoutCartDrawer")

<div class="cf-toast" id="cfToast" role="status" aria-live="polite">
    <i class="bi bi-check-circle-fill"></i> <span id="cfToastText">Added to cart</span>
</div>

@await Component.InvokeAsync("_ProductDetailLayoutScripts", Model)

