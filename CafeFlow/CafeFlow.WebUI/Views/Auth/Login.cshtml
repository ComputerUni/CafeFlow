@using CafeFlow.DTO.Auth
@model LoginDto

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap — CafeFlow</title>
    <meta name="description" content="CafeFlow hesabınıza giriş yapın, tatlı siparişlerinizi ve favorilerinizi yönetin." />

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --cf-pink-50: #fff6f8;
                --cf-pink-100: #fde8ee;
                --cf-pink-200: #f9d3de;
                --cf-pink-300: #f4b8c9;
                --cf-rose: #e88ea6;
                --cf-rose-deep: #d46f8c;
                --cf-peach: #ffe4d6;
                --cf-cream: #fdf8f2;
                --cf-offwhite: #fffcfa;
                --cf-coffee: #6b4a3a;
                --cf-coffee-2: #9a7462;
                --cf-ink: #3d2a24;
                --cf-muted: #8a7470;
                --cf-radius-sm: 12px;
                --cf-radius: 20px;
                --cf-radius-lg: 32px;
                --cf-shadow: 0 14px 40px rgba(212, 111, 140, 0.12);
                --cf-shadow-lg: 0 24px 60px rgba(150, 80, 100, 0.16);
                --cf-font-display: "Playfair Display", Georgia, serif;
                --cf-font-body: "DM Sans", system-ui, -apple-system, sans-serif;
                --cf-ease: cubic-bezier(.2, .8, .2, 1);
            }

            body {
                font-family: var(--cf-font-body);
                color: var(--cf-ink);
                background: var(--cf-offwhite);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                position: relative;
                overflow-x: hidden;
            }

            /* Ambient Blobs */
            .cf-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(70px);
                opacity: .5;
                pointer-events: none;
                z-index: 0;
            }

            .cf-blob-1 {
                width: 420px;
                height: 420px;
                background: var(--cf-pink-200);
                top: -100px;
                right: -80px;
            }

            .cf-blob-2 {
                width: 360px;
                height: 360px;
                background: var(--cf-peach);
                bottom: -60px;
                left: -80px;
            }

            /* Brand Logo */
            .cf-logo {
                font-family: var(--cf-font-display);
                font-weight: 700;
                font-size: 1.6rem;
                color: var(--cf-coffee);
                display: inline-flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

                .cf-logo span:not(.cf-logo-mark) {
                    color: var(--cf-rose-deep);
                }

            .cf-logo-mark {
                width: 42px;
                height: 42px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                background: linear-gradient(135deg, var(--cf-pink-200), var(--cf-peach));
                color: var(--cf-rose-deep);
                font-size: 1.15rem;
            }

            /* Auth Shell */
            .cf-auth-wrap {
                flex: 1;
                display: grid;
                place-items: center;
                padding: 40px 16px;
                position: relative;
                z-index: 1;
            }

            .cf-auth-card {
                background: #fff;
                border: 1px solid var(--cf-pink-100);
                border-radius: var(--cf-radius-lg);
                box-shadow: var(--cf-shadow-lg);
                overflow: hidden;
                width: 100%;
                max-width: 960px;
                display: grid;
                grid-template-columns: 1fr 1.1fr;
            }

            /* Left Side: Visual Story */
            .cf-auth-visual {
                background: linear-gradient(150deg, var(--cf-pink-100) 0%, var(--cf-peach) 100%);
                padding: 48px 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                overflow: hidden;
            }

                .cf-auth-visual::after {
                    content: "";
                    position: absolute;
                    width: 280px;
                    height: 280px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, .35);
                    top: -80px;
                    right: -80px;
                }

            .cf-visual-quote {
                position: relative;
                z-index: 1;
            }

                .cf-visual-quote h2 {
                    font-family: var(--cf-font-display);
                    font-size: 2.2rem;
                    font-weight: 600;
                    color: var(--cf-coffee);
                    line-height: 1.2;
                    margin-bottom: 14px;
                }

                    .cf-visual-quote h2 em {
                        font-style: italic;
                        color: var(--cf-rose-deep);
                    }

                .cf-visual-quote p {
                    color: var(--cf-coffee-2);
                    font-size: 1rem;
                    line-height: 1.6;
                }

            .cf-auth-badge {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                background: rgba(255, 255, 255, .9);
                backdrop-filter: blur(8px);
                padding: 10px 16px;
                border-radius: 999px;
                font-size: .88rem;
                font-weight: 600;
                color: var(--cf-coffee);
                box-shadow: var(--cf-shadow);
                z-index: 1;
            }

                .cf-auth-badge i {
                    color: var(--cf-rose-deep);
                    font-size: 1.1rem;
                }

            /* Right Side: Form */
            .cf-auth-body {
                padding: 50px 46px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .cf-auth-head {
                margin-bottom: 28px;
            }

            .cf-auth-title {
                font-family: var(--cf-font-display);
                font-weight: 600;
                font-size: 1.95rem;
                color: var(--cf-coffee);
                margin-bottom: 6px;
            }

            .cf-auth-sub {
                color: var(--cf-muted);
                font-size: .94rem;
            }

            /* Form Fields */
            .cf-label {
                font-size: .85rem;
                font-weight: 600;
                color: var(--cf-coffee);
                margin-bottom: 7px;
                display: block;
            }

            .cf-input-wrap {
                position: relative;
                margin-bottom: 18px;
            }

            .cf-input-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cf-rose);
                font-size: 1.1rem;
                pointer-events: none;
            }

            .cf-input {
                width: 100%;
                height: 48px;
                border-radius: 14px;
                border: 1.5px solid var(--cf-pink-100);
                background: var(--cf-pink-50);
                color: var(--cf-ink);
                padding: 0 46px 0 46px;
                font-size: .95rem;
                outline: none;
                transition: all .25s var(--cf-ease);
            }

                .cf-input::placeholder {
                    color: #bcaaa6;
                }

                .cf-input:focus {
                    background: #fff;
                    border-color: var(--cf-pink-300);
                    box-shadow: 0 0 0 4px rgba(244, 184, 201, .25);
                }

            .cf-pwd-toggle {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: none;
                color: var(--cf-muted);
                cursor: pointer;
                padding: 4px;
                font-size: 1.05rem;
                transition: color .2s;
            }

                .cf-pwd-toggle:hover {
                    color: var(--cf-rose-deep);
                }

            /* Checkbox & Links */
            .cf-check-wrap {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 24px;
                font-size: .86rem;
            }

            .cf-check-label {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: var(--cf-coffee-2);
                cursor: pointer;
                user-select: none;
            }

                .cf-check-label input {
                    accent-color: var(--cf-rose-deep);
                    width: 16px;
                    height: 16px;
                    cursor: pointer;
                }

            .cf-link {
                color: var(--cf-rose-deep);
                text-decoration: none;
                font-weight: 600;
                transition: color .2s;
            }

                .cf-link:hover {
                    color: var(--cf-coffee);
                }

            /* Action Button */
            .cf-btn-primary {
                background: linear-gradient(135deg, var(--cf-rose), var(--cf-rose-deep));
                color: #fff;
                border: none;
                border-radius: 999px;
                height: 48px;
                font-weight: 600;
                font-size: 1rem;
                box-shadow: 0 10px 24px rgba(212, 111, 140, .28);
                transition: all .3s var(--cf-ease);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
            }

                .cf-btn-primary:hover {
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 14px 28px rgba(212, 111, 140, .36);
                }

            /* Switch View Footer */
            .cf-auth-foot {
                text-align: center;
                margin-top: 24px;
                font-size: .9rem;
                color: var(--cf-muted);
            }

            /* Quick Social / Demo Divider */
            .cf-or-divider {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: .76rem;
                font-weight: 700;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: #c4aca7;
                margin: 22px 0;
            }

                .cf-or-divider::before, .cf-or-divider::after {
                    content: "";
                    flex: 1;
                    height: 1px;
                    background: var(--cf-pink-100);
                }

            @@media (max-width: 991.98px) {
                .cf-auth-card {
                    grid-template-columns: 1fr;
                    max-width: 480px;
                }

                .cf-auth-visual {
                    display: none;
                }

                .cf-auth-body {
                    padding: 40px 28px;
                }
            }
    </style>
</head>
<body>

    <div class="cf-blob cf-blob-1"></div>
    <div class="cf-blob cf-blob-2"></div>

    <main class="cf-auth-wrap">
        <div class="cf-auth-card">

            <!-- Visual Banner -->
            <div class="cf-auth-visual">
                <a href="index.html" class="cf-logo">
                    <span class="cf-logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
                    Cafe<span>Flow</span>
                </a>

                <div class="cf-visual-quote my-auto py-4">
                    <h2>Tekrar hoş geldin,<br /><em>günün kahvesi</em> seni bekliyor.</h2>
                    <p>Favori tatlılarınızı sepete ekleyin, sipariş durumunuzu takip edin ve size özel sürpriz indirimleri yakalayın.</p>
                </div>

                <div class="cf-auth-badge">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Hızlı ve Güvenli QR / Masadan Sipariş</span>
                </div>
            </div>

            <!-- Login Form Body -->
            <div class="cf-auth-body">
                <div class="d-lg-none mb-4 text-center">
                    <a href="index.html" class="cf-logo">
                        <span class="cf-logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
                        Cafe<span>Flow</span>
                    </a>
                </div>

                <div class="cf-auth-head">
                    <h1 class="cf-auth-title">Giriş Yap</h1>
                    <p class="cf-auth-sub">CafeFlow hesabınıza erişmek için bilgilerinizi girin.</p>
                </div>

                <form id="loginForm" asp-action="Login" asp-controller="Auth" method="post">
                    <div>
                        <label class="cf-label" for="loginEmail">E-posta Adresi</label>
                        <div class="cf-input-wrap">
                            <i class="bi bi-envelope cf-input-icon"></i>
                            <input asp-for="Email" type="email" id="loginEmail" class="cf-input" placeholder="adiniz@example.com" required autocomplete="username" />
                        </div>
                    </div>

                    <div>
                        <label class="cf-label" for="loginPassword">Şifre</label>
                        <div class="cf-input-wrap">
                            <i class="bi bi-lock cf-input-icon"></i>
                            <input asp-for="Password" type="password" id="loginPassword" class="cf-input" placeholder="••••••••" required autocomplete="current-password" />
                            <button type="button" class="cf-pwd-toggle" id="togglePassword" aria-label="Şifreyi göster/gizle">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="cf-check-wrap">
                        <label class="cf-check-label">
                            <input type="checkbox" id="rememberMe" checked />
                            <span>Beni hatırla</span>
                        </label>
                        <a href="#" class="cf-link">Şifremi unuttum</a>
                    </div>

                    <button type="submit" class="cf-btn-primary">
                        Giriş Yap <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <div class="cf-or-divider">veya</div>

                <a href="/Default/Index" class="btn btn-outline-secondary w-100 rounded-pill py-2" style="border-color:var(--cf-pink-200); color:var(--cf-coffee); font-weight:600; font-size:.9rem;">
                    <i class="bi bi-house me-1"></i> Misafir Olarak Menüye Dön
                </a>

                <div class="cf-auth-foot">
                    Henüz hesabınız yok mu? <a asp-controller="Auth" asp-action="Register" class="cf-link">Hemen Kayıt Olun</a>
                </div>
            </div>

        </div>
    </main>

    <script>
            // Şifre Göster / Gizle Mantığı
            const toggleBtn = document.getElementById("togglePassword");
            const pwdInput = document.getElementById("loginPassword");
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener("click", () => {
                    const isPwd = pwdInput.type === "password";
                    pwdInput.type = isPwd ? "text" : "password";
                    toggleBtn.querySelector("i").className = `bi bi-${isPwd ? "eye-slash" : "eye"}`;
                });
            }
    </script>
</body>
</html>